NOREN_BIN = os.path.join(os.path.dirname(HOST_DIR), "bin", "noren")
SETS_FILE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "noren", "sets.json",
)
START_FILE = os.path.join(os.path.dirname(SETS_FILE), "start.json")
CONFIG_FILE = os.path.join(os.path.dirname(SETS_FILE), "config.json")
SITES_DIR = os.path.join(os.path.dirname(SETS_FILE), "sites")
SITES_INDEX = os.path.join(SITES_DIR, "index.json")
SITE_MAX_BYTES = 128 * 1024


