#!/usr/bin/env python3
"""Noren — native messaging host.

Chromium starts this process and owns its lifetime. It speaks two protocols:

  stdin/stdout   Chromium native messaging (4-byte little-endian length + JSON)
  unix socket    line-delimited JSON, for the `noren` CLI and the Omarchy shell

Anything written to stdout that is not a framed native message corrupts the
channel, so every diagnostic goes to stderr.
"""

import atexit
import json
import os
import signal
import socket
import struct
import subprocess
import sys
import threading
import itertools
import time

