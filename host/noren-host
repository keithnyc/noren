_theme_mode = "tint"
_socket_inode = None
# When this host started, which is when the extension last connected: the host
# dies with the extension's port and a new one starts with it. `noren ping`
# reports it, so "did my reload take?" has an answer that cannot go stale.
_started = time.monotonic()

# The generated page stylesheets for the active Omarchy theme, and the mtime of
# the colors.toml they came from. The extension cannot read the filesystem, so
# the host is the only thing that can hand it a theme at all.
_theme = None
_theme_stamp = None


# Stderr belongs to Chromium and is thrown away with it, which is no use the
# morning after: "a window appeared and I have no idea how" needs a record that
# outlives the browser. Small, capped, and local.
LOG_FILE = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "noren", "host.log",
)
LOG_MAX_BYTES = 256 * 1024


def log(*args):
    line = " ".join(str(a) for a in args)
    print("noren-host:", line, file=sys.stderr, flush=True)
    try:
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        if os.path.exists(LOG_FILE) and os.path.getsize(LOG_FILE) > LOG_MAX_BYTES:
            # Keep the second half rather than rotating: one file, no growth.
            with open(LOG_FILE, "r", errors="replace") as fh:
                kept = fh.read()[LOG_MAX_BYTES // 2:]
            with open(LOG_FILE, "w") as fh:
                fh.write(kept)
        with open(LOG_FILE, "a") as fh:
            fh.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), line))
    except OSError:
        pass


# --------------------------------------------------------------- native messaging


def read_native():
    """Block for one message from Chromium. Returns None at EOF."""
    header = sys.stdin.buffer.read(4)
    if len(header) < 4:
        return None
    (length,) = struct.unpack("<I", header)
    body = sys.stdin.buffer.read(length)
    if len(body) < length:
        return None
    try:
        return json.loads(body)
    except json.JSONDecodeError as exc:
        log("bad json from extension:", exc)
        return {}


def write_native(payload):
    data = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    with _write_lock:
        sys.stdout.buffer.write(struct.pack("<I", len(data)))
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()


def ask_extension(cmd, timeout=5.0, **kwargs):
    """Send a command and wait for the matching reply."""
    msg_id = next(_ids)
    event = threading.Event()
    with _pending_lock:
        _pending[msg_id] = [event, None]

    write_native({"id": msg_id, "cmd": cmd, **kwargs})

    if not event.wait(timeout):
        with _pending_lock:
            _pending.pop(msg_id, None)
        return {"ok": False, "error": "timed out waiting for the browser"}

    with _pending_lock:
        return _pending.pop(msg_id)[1] or {"ok": False, "error": "empty reply"}


# ------------------------------------------------------------------ shell bridge


def notify_shell(state):
    """Push browser state into the Omarchy shell plugin, best effort."""
    try:
        subprocess.run(
            [
                "omarchy-shell",
                "-q",
                PLUGIN_ID,
                "setState",
                json.dumps(state or {}, separators=(",", ":")),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
        )
    except Exception:
        pass


# ------------------------------------------------------------ browser resolution
#
# We cannot go through omarchy-launch-webapp. It runs the distro launcher
# script, and the Brave wrapper ends with
#
#     exec ".../brave-origin" "$USER_FLAGS" "$BRAVE_FLAGS" "$FLAG" "$@"
#
# with $BRAVE_FLAGS and $FLAG unset — so two empty-string arguments land in
# argv ahead of ours and --app= is swallowed. You get an ordinary browser
# window instead of a chrome-less one. Resolve the real binary and call it
# with clean arguments instead.

_browser = None


def resolve_browser():
    """(binary, user_data_dir) for the default browser, resolved once."""
    global _browser
    if _browser is not None:
        return _browser

    binary, data_dir = None, None
    try:
        desktop = subprocess.run(
            # Omarchy exports BROWSER=omarchy-launch-browser, which makes
            # xdg-settings refuse to answer. Its own scripts unset it first.
            ["env", "-u", "BROWSER", "xdg-settings", "get", "default-web-browser"],
            capture_output=True, text=True, timeout=4,
        ).stdout.strip()

        path = None
        for base in (
            os.path.expanduser("~/.local/share/applications"),
            "/usr/share/applications",
        ):
            candidate = os.path.join(base, desktop)
            if os.path.isfile(candidate):
                path = candidate
                break

        if path:
            with open(path) as fh:
                for line in fh:
                    if line.startswith("Exec="):
                        binary = line[5:].split()[0]
                        break

        # The launcher is usually a shell wrapper. Follow it to the real ELF,
        # picking up the profile directory it would have exported.
        seen = set()
        while binary and binary not in seen and os.path.isfile(binary):
            seen.add(binary)
            with open(binary, "rb") as fh:
                head = fh.read(2)
            if head != b"#!":
                break
            with open(binary, errors="replace") as fh:
                text = fh.read()
            for line in text.splitlines():
                line = line.strip()
                if "CHROME_USER_DATA_DIR=" in line and not data_dir:
                    data_dir = os.path.expanduser(
                        line.split("CHROME_USER_DATA_DIR=", 1)[1].strip().strip('"')
                    )
                if line.startswith("exec ") and '"' in line:
                    nxt = line.split('"')[1]
                    if os.path.isfile(nxt):
                        binary = nxt
                        break
            else:
                break

        # If we are still on a shell wrapper, the real ELF sits beside it in
        # the vendor tree. Only look when we have not already got a binary --
        # /usr/bin holds every browser on the system, so searching there would
        # happily hand back a different browser than the one we were asked for.
        if binary and os.path.isfile(binary):
            with open(binary, "rb") as fh:
                is_elf = fh.read(4) == b"\x7fELF"
            if not is_elf:
                for sibling in ("brave", "chrome", "chromium"):
                    candidate = os.path.join(os.path.dirname(binary), sibling)
                    if os.path.isfile(candidate):
                        with open(candidate, "rb") as fh:
                            if fh.read(4) == b"\x7fELF":
                                binary = candidate
                                break
    except Exception as exc:
        log("browser resolution failed:", exc)

    _browser = (binary, data_dir)
    log("browser:", binary, "profile:", data_dir)
    return _browser


def owning_browser():
    """Which browser actually started this host. Ground truth, not config."""
    try:
        ppid = os.getppid()
        exe = os.readlink("/proc/%d/exe" % ppid)
        return {"pid": ppid, "name": os.path.basename(exe), "exe": exe}
    except Exception:
        return None


def normalize_url(url):
    """Chromium's --app= needs an absolute URL.

    Given a bare host like "search.example" it does not error — it ignores the switch
    and opens an ordinary browser window, which looks exactly like the feature
    silently not working. omarchy-webapp-install normalises for the same reason.
    """
    import re

    raw = str(url or "").strip()
    if not raw:
        return None
    if re.match(r"^https?://", raw, re.I):
        return raw
    # Refuse the schemes --app= would execute as a document rather than load.
    if re.match(r"^[a-z][a-z0-9+.-]*:", raw, re.I):
        return None
    return "https://" + raw


def spawn_window(url):
    """Open a URL as its own chrome-less Hyprland window."""
    asked = url
    url = normalize_url(url)
    if not url:
        log("refused to open (not a web address):", repr(asked))
        return
    log("spawning window:", url)
    _spawn_app(url)


def start_url():
    """The start page, or None before install.sh has pinned the extension id.

    Built here from the id rather than accepted from a caller: normalize_url
    refuses every non-web scheme on purpose, and this is the one exception, so
    it must not become a way to open arbitrary extension pages.
    """
    try:
        with open(os.path.join(HOST_DIR, ".extid"), "r") as fh:
            ext_id = fh.read().strip()
    except OSError:
        return None
    if not ext_id.isalpha():
        return None
    return "chrome-extension://%s/start.html" % ext_id


def spawn_start():
    url = start_url()
    if not url:
        log("no extension id; cannot open the start page")
        return False
    _spawn_app(url)
    return True


def _spawn_app(url):
    binary, data_dir = resolve_browser()
    if not binary:
        # Better a normal window than none at all.
        try:
            subprocess.Popen(
                ["omarchy-launch-webapp", url],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except FileNotFoundError:
            log("no browser binary and no omarchy-launch-webapp")
        return

    argv = [binary]
    if data_dir:
        argv.append("--user-data-dir=" + data_dir)
    argv.append("--app=" + url)

    # No --class here: Chromium ignores it for app windows on Wayland. It
    # derives the app_id from the URL and profile instead, as
    #
    #     chrome-<host><path, / replaced by _>-<profile>
    #     e.g. chrome-news.example.com__-Default
    #
    # which is what Hyprland windowrules must match on. Per-site identity comes
    # free; we just do not get to choose the name.

    try:
        subprocess.Popen(
            argv,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        log("spawn failed:", exc)


# ----------------------------------------------------------------------- sets


def read_sets():
    """Sets as a list, in saved order. The CLI owns the format; this only reads."""
    try:
        with open(SETS_FILE, "r") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return []
    if not isinstance(data, dict):
        return []
    out = []
    for name, entry in data.items():
        if isinstance(entry, dict) and isinstance(entry.get("urls"), list):
            out.append({
                "name": name,
                "urls": [u for u in entry["urls"] if isinstance(u, str)],
                "grouped": bool(entry.get("grouped")),
            })
    return out


def save_start(hidden):
    """Mirror the start page's hidden sites for the CLI's offline list.

    The extension's storage is the source; this copy exists only because the
    CLI cannot read Chromium's LevelDB, and with the browser closed a site you
    hid would otherwise come straight back in the url bar.
    """
    if not isinstance(hidden, list):
        return
    hosts = sorted({str(h).lower() for h in hidden if isinstance(h, str) and h})
    try:
        os.makedirs(os.path.dirname(START_FILE), exist_ok=True)
        tmp = START_FILE + ".tmp"
        with open(tmp, "w") as fh:
            json.dump({"hidden": hosts}, fh, indent=2)
        os.replace(tmp, START_FILE)
    except OSError as exc:
        log("could not save start.json:", exc)


def tabbed_anchor():
    """The focused chrome-less window and every chrome-less address right now.

    Read before the spawn: afterwards the new window may already be focused,
    and it cannot be its own anchor.
    """
    clients = _hypr_json("clients") or []
    addresses = {
        c.get("address") for c in clients
        if (c.get("class") or "").lower().startswith("chrome-") and c.get("address")
    }
    active = _hypr_json("activewindow") or {}
    cls = (active.get("class") or "").lower()
    anchor = active.get("address") if cls.startswith("chrome-") else None
    return anchor, addresses


def join_spawned(anchor, before):
    """Fold the window that just appeared into the anchor's group, via the CLI.

    The CLI owns every group dispatch -- `gather` is careful about targeting in
    ways this host has no business duplicating.
    """
    try:
        subprocess.run(
            [NOREN_BIN, "join", "--anchor", anchor, "--exclude", ",".join(sorted(before))],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        log("join failed:", exc)


# Hyprland events that can change what a tab strip should show: a window
# opening or closing, moving, joining or leaving a group, or simply becoming
# the active one (the strip marks which page you are on).
GROUP_EVENTS = (
    "openwindow", "closewindow", "movewindow", "movewindowv2",
    "togglegroup", "moveintogroup", "moveoutofgroup",
    "activewindow", "activewindowv2", "changefloatingmode",
)

# Which page is active changes on a keystroke and the strip's marker should be
# moving with the compositor's own fade, so these are passed on at once -- only
# enough delay to coalesce the pair Hyprland sends together. The rest are
# structural (a window opened, a group folded) and worth waiting out: `gather`
# folding four windows is one burst, and only the end state matters.
FOCUS_EVENTS = ("activewindow", "activewindowv2")
FOCUS_DEBOUNCE = 0.02
STRUCTURE_DEBOUNCE = 0.15


# ------------------------------------------------------------------ snapshots
#
# A window that closes is gone before anyone hears about it, so the picture the
# curtain tears up has to already exist. Rebinding the close key would solve it
# the other way, but SUPER + W is Omarchy's and Noren has no business taking it:
# the point of this plugin is that the compositor stays in charge.
#
# So: keep one recent snapshot per page window, taken when something actually
# changes -- the window takes focus, or its page navigates (the extension says
# so). Not on a timer; there is nothing to photograph between those.

SNAPSHOT_DIR = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
SNAPSHOT_MAX_AGE = 15 * 60
_snapshots = {}          # address -> file path
_snapshot_lock = threading.Lock()


def page_clients():
    """Chrome-less windows right now, by address."""
    out = {}
    for client in _hypr_json("clients") or []:
        cls = (client.get("class") or "").lower()
        address = client.get("address") or ""
        at = client.get("at") or []
        size = client.get("size") or []
        if not cls.startswith("chrome-") or not address or len(at) < 2 or len(size) < 2:
            continue
        out[address] = {"x": at[0], "y": at[1], "w": size[0], "h": size[1]}
    return out


def snapshot_focused():
    """Photograph the page window in front, if there is one."""
    if not shatter_style_name(read_config()) or shatter_style_name(read_config()) == "off":
        return
    client = browser_client()
    if not client or not (client.get("class") or "").lower().startswith("chrome-"):
        return
    address = client.get("address") or ""
    at = client.get("at") or []
    size = client.get("size") or []
    if not address or len(at) < 2 or len(size) < 2 or size[0] < 1 or size[1] < 1:
        return

    path = os.path.join(SNAPSHOT_DIR, "noren-snap-%s.png" % address.replace("0x", ""))
    try:
        done = subprocess.run(
            ["grim", "-g", f"{at[0]},{at[1]} {size[0]}x{size[1]}", path],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        log("snapshot failed:", exc)
        return
    if done.returncode == 0:
        with _snapshot_lock:
            _snapshots[address] = path


def drop_snapshot(address):
    with _snapshot_lock:
        path = _snapshots.pop(address, None)
    if not path:
        return
    try:
        os.unlink(path)
    except OSError:
        pass


def snapshot_for(address):
    with _snapshot_lock:
        path = _snapshots.get(address)
    if not path or not os.path.exists(path):
        return ""
    try:
        if time.time() - os.path.getmtime(path) > SNAPSHOT_MAX_AGE:
            return ""
    except OSError:
        return ""
    return path


def burst_closed(address, where):
    """Ask the shell to play the close, with the last picture of that window."""
    style = shatter_style_name(read_config())
    if not style or style == "off":
        drop_snapshot(address)
        return
    payload = json.dumps({
        "x": where["x"], "y": where["y"], "w": where["w"], "h": where["h"],
        "address": address,
        "image": snapshot_for(address),
        "style": style,
    })
    try:
        subprocess.run(
            ["omarchy-shell", "-q", PLUGIN_ID, "shatter", payload],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        log("could not play the close:", exc)
    # The shell has the pixels now.
    threading.Timer(2.5, drop_snapshot, args=(address,)).start()


def watch_hyprland():
    """Tell the extension when the grouping changed.

    The browser cannot see any of this: a window joining a group is a
    compositor event, so without this the bar's tab strip stayed as it was drawn
    and only caught up when the page was reloaded. Events are debounced --
    `gather` folding four windows is a burst, and the strip only needs the end
    state.
    """
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not sig or not runtime:
        return
    path = os.path.join(runtime, "hypr", sig, ".socket2.sock")

    while True:
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(path)
        except OSError:
            time.sleep(5)
            continue

        buffer = b""
        pending_since = None
        pending_wait = STRUCTURE_DEBOUNCE
        # Where each page window was, so one that closes can still be drawn.
        known = page_clients()
        snap_at = None
        try:
            while True:
                sock.settimeout(0.01)
                try:
                    chunk = sock.recv(4096)
                    if not chunk:
                        break
                    buffer += chunk
                    while b"\n" in buffer:
                        line, buffer = buffer.split(b"\n", 1)
                        text = line.decode("utf-8", "replace")
                        name = text.split(">>", 1)[0]
                        if name == "closewindow":
                            # `closewindow>>55aabb` -- addresses arrive without
                            # the 0x that `hyprctl clients` reports.
                            gone = ("0x" + text.split(">>", 1)[1].strip()
                                    if ">>" in text else "")
                            where = known.pop(gone, None)
                            if where:
                                threading.Thread(target=burst_closed,
                                                 args=(gone, where), daemon=True).start()
                        elif name in ("openwindow", "movewindow", "movewindowv2",
                                      "resizewindow", "activewindowv2"):
                            known = page_clients()
                            # A moment after focus lands, so the window has
                            # settled and drawn before it is photographed.
                            snap_at = time.monotonic() + 0.45
                        if name not in GROUP_EVENTS:
                            continue
                        wait = FOCUS_DEBOUNCE if name in FOCUS_EVENTS else STRUCTURE_DEBOUNCE
                        if pending_since is None:
                            pending_since = time.monotonic()
                            pending_wait = wait
                        else:
                            # A burst that mixes both waits for the shorter one:
                            # a focus change inside it is the part being watched.
                            pending_wait = min(pending_wait, wait)
                except socket.timeout:
                    pass
                if pending_since and time.monotonic() - pending_since >= pending_wait:
                    pending_since = None
                    pending_wait = STRUCTURE_DEBOUNCE
                    write_native({"type": "groupChanged"})
                if snap_at and time.monotonic() >= snap_at:
                    snap_at = None
                    threading.Thread(target=snapshot_focused, daemon=True).start()
        except OSError:
            pass
        finally:
            sock.close()
        time.sleep(1)


# A scattered workspace can hold a lot of pages; a strip is a strip.
LOOSE_STRIP_MAX = 10


_switch_ms = None


def window_switch_ms():
    """How long Hyprland takes to fade between windows, in milliseconds.

    The bar's tab strip marks the page you are on; moving that marker in step
    with the compositor's own switch is the difference between one movement and
    two. Read from Hyprland rather than guessed, because it is the user's
    setting -- `speed` is in deciseconds -- and cached, because it changes only
    when they reload their config.
    """
    global _switch_ms
    if _switch_ms is not None:
        return _switch_ms
    _switch_ms = 220
    try:
        for animation in _hypr_json("animations") or []:
            if not isinstance(animation, list):
                continue
            for entry in animation:
                if isinstance(entry, dict) and entry.get("name") == "fadeSwitch":
                    speed = float(entry.get("speed") or 0)
                    if speed > 0:
                        _switch_ms = max(80, min(600, int(speed * 100)))
    except (TypeError, ValueError):
        pass
    return _switch_ms


def group_members():
    """(grouped, pages) for the reveal bar's strip.

    Grouped, that is the group's own tabs, in group order. Not grouped, it is
    the other chrome-less pages on this workspace -- so scattering a group does
    not take the switcher away with it, which is exactly when the pages are
    spread out and worth switching between. The bar draws those more quietly:
    they are pages, not tabs, and the strip should not claim otherwise.

    Hyprland knows the grouping and the titles; the worker matches those titles
    to its own tabs for urls and favicons. The bar is only ever shown on the
    window the pointer is over, which is the focused one, so "the window in
    front" is the right window to ask about.
    """
    client = browser_client()
    if not client or not (client.get("class") or "").lower().startswith("chrome-"):
        return False, []

    clients = _hypr_json("clients") or []
    by_address = {c.get("address"): c for c in clients if c.get("address")}

    def describe(member, address):
        title = member.get("title") or ""
        return {
            "address": address,
            # The browser's suffix is noise in a chip this small.
            "title": title.rsplit(" - ", 1)[0] if " - " in title else title,
            "appId": member.get("class") or "",
            "active": address == client.get("address"),
        }

    grouped = client.get("grouped") or []
    if len(grouped) >= 2:
        pages = [describe(by_address[a], a) for a in grouped if a in by_address]
        return True, pages

    workspace = (client.get("workspace") or {}).get("id")
    loose = [
        c for c in clients
        if (c.get("class") or "").lower().startswith("chrome-")
        and (c.get("workspace") or {}).get("id") == workspace
        and not c.get("hidden")
    ]
    # Left to right, top to bottom: the order they are on screen, which is the
    # order the eye expects in a strip.
    loose.sort(key=lambda c: ((c.get("at") or [0, 0])[1], (c.get("at") or [0, 0])[0]))
    pages = [describe(c, c.get("address")) for c in loose[:LOOSE_STRIP_MAX]]
    return False, pages


def raise_member(address):
    """Focus a window, but only one in the group the bar belongs to.

    The request comes from a content script, which speaks for a page: it may
    name a window in its own group and nothing else.
    """
    address = str(address or "")
    _, members = group_members()
    if address not in {m["address"] for m in members}:
        log("refusing to raise a window outside the group:", address)
        return
    try:
        subprocess.Popen(
            [NOREN_BIN, "raise", address],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        log("raise failed:", exc)


def set_op(msg):
    """Edit sets for the start page, through the CLI, which owns the format.

    Only three operations, each mapped to fixed CLI arguments: nothing from the
    message is ever used as an argument except a set name, which is passed
    after the subcommand where it cannot be read as a flag's value.
    """
    op = msg.get("op")
    data = msg.get("data") if isinstance(msg.get("data"), dict) else {}
    stdin = None
    if op == "put":
        argv = [NOREN_BIN, "set", "put"]
        stdin = json.dumps(data)
    elif op == "rm":
        argv = [NOREN_BIN, "set", "rm", str(data.get("name") or "")]
    elif op == "save":
        argv = [NOREN_BIN, "set", "save", str(data.get("name") or "")]
    else:
        write_native({"type": "setOpResult", "id": msg.get("id"),
                      "ok": False, "error": "unknown set operation"})
        return
    try:
        out = subprocess.run(argv, input=stdin, capture_output=True, text=True, timeout=15)
        ok = out.returncode == 0
        error = "" if ok else (out.stderr.strip() or out.stdout.strip() or "failed")
    except (OSError, subprocess.SubprocessError) as exc:
        ok, error = False, str(exc)
    # The CLI prefixes its messages for a terminal; the page shows them bare.
    error = error.replace("noren set put: ", "").replace("noren set save: ", "") \
        .replace("noren set rm: ", "").replace("noren: ", "")
    write_native({"type": "setOpResult", "id": msg.get("id"), "ok": ok, "error": error})


def site_summary():
    """The site scripts, for the start page's settings panel.

    Summary only -- host, kinds, on or off, when it changed. The page has no
    business with the source, and reading a file into an extension page would
    put a script the agent wrote somewhere it could be pasted by accident.
    """
    try:
        with open(SITES_INDEX, "r") as fh:
            index = json.load(fh)
    except (OSError, ValueError):
        return []
    if not isinstance(index, dict):
        return []

    out = []
    for host in sorted(index):
        entry = index[host] if isinstance(index[host], dict) else {}
        kinds = [kind for kind in ("css", "js") if entry.get(kind)]
        out.append({
            "host": host,
            "kinds": kinds,
            "enabled": entry.get("enabled", True) is not False,
            "updated": str(entry.get("updated") or ""),
        })
    return out


def site_op(msg):
    """Turn a site script on or off, or throw it away -- through the CLI.

    The same shape as `set_op`: a fixed subcommand and a host, nothing from the
    message used as a flag. Turning one on applies it to the open pages, which
    the CLI does; turning one off cannot un-inject what a page already ran, so
    the page says as much.
    """
    op = msg.get("op")
    host = str(msg.get("host") or "")
    if op not in ("on", "off", "rm") or not host or host.startswith("-"):
        write_native({"type": "siteOpResult", "id": msg.get("id"),
                      "ok": False, "error": "unknown site operation"})
        return
    try:
        out = subprocess.run([NOREN_BIN, "site", op, host],
                             capture_output=True, text=True, timeout=15)
        ok = out.returncode == 0
        error = "" if ok else (out.stderr.strip() or out.stdout.strip() or "failed")
    except (OSError, subprocess.SubprocessError) as exc:
        ok, error = False, str(exc)
    error = error.replace("noren site: ", "").replace("noren: ", "")
    write_native({"type": "siteOpResult", "id": msg.get("id"),
                  "ok": ok, "error": error})


def open_set(name, replace=False):
    """Open a set through the CLI, which owns grouping.

    Grouping means waiting for windows to appear and then driving Hyprland,
    all of which `noren set open` already does carefully. Only a name that is
    actually a saved set is passed on, so a message cannot smuggle a flag in.
    """
    name = str(name or "")
    if name not in {s["name"] for s in read_sets()}:
        log("no such set:", name)
        return
    try:
        subprocess.Popen(
            [NOREN_BIN, "set", "open", name] + (["--replace"] if replace else []),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        log("set open failed:", exc)


# ------------------------------------------------------------- window targeting
#
# Chromium's "last focused window" drifts from what you are actually looking
# at: run a command from a terminal and Chromium is not focused at all, so it
# answers with whatever browser window it saw last — often on another
# workspace. Ask Hyprland instead, and let the extension match on title.


def _hypr_json(what):
    try:
        return json.loads(
            subprocess.run(
                ["hyprctl", "-j", what],
                capture_output=True, text=True, timeout=3,
            ).stdout
        )
    except Exception:
        return None


def _is_browser(client):
    """A window belonging to the browser that owns this bridge.

    Not "any browser". Only one browser can hold the socket, so a window from a
    different one is a window we cannot drive -- sending it a matchTitle just
    makes the extension fall back to its own idea of focus, silently acting
    somewhere else. Chrome-less windows count whatever their name, since those
    are the ones Noren itself spawned.
    """
    cls = (client.get("class") or "").lower() if client else ""
    if not cls:
        return False
    if cls.startswith("chrome-"):
        return True
    owner = owning_browser() or {}
    name = (owner.get("name") or "").lower()
    return bool(name) and name in cls


def browser_client():
    """The browser window a command should act on.

    Prefer whatever Hyprland says is focused. "First browser window on the
    active workspace" was right only while there was at most one: `gather` puts
    several on the same workspace, and list order then picks an arbitrary member
    -- usually the oldest. That is how `back` ended up acting on the window a
    link was opened *from* rather than the one in front of you.

    The workspace scan stays as the fallback, because a command issued from a
    terminal or a keybind arrives with the browser not focused at all. There it
    skips hidden windows: the inactive members of a group are stacked behind the
    active one, and none of them is what you are looking at.
    """
    active = _hypr_json("activewindow") or {}
    if _is_browser(active) and active.get("class"):
        return active

    ws_id = (_hypr_json("activeworkspace") or {}).get("id")
    here = [
        c for c in (_hypr_json("clients") or [])
        if _is_browser(c) and c.get("workspace", {}).get("id") == ws_id
    ]
    for c in here:
        if not c.get("hidden"):
            return c
    return here[0] if here else None


def hypr_browser_window():
    """{title, app_id, chromeless} for the browser window in front of you.

    Chromium names --app windows `chrome-<host>_<path>-<profile>`, and ordinary
    tabbed windows just `chromium` / `brave-...`. That distinction is what tells
    us whether the thing in front of you is a page or merely the tabbed window
    the extension happens to live in.
    """
    client = browser_client()
    if not client:
        return None
    cls = client.get("class") or ""
    title = client.get("title") or ""
    return {
        "title": title.rsplit(" - ", 1)[0] if " - " in title else title,
        "app_id": cls,
        "chromeless": cls.lower().startswith("chrome-"),
    }


def hypr_target_title():
    """Title of the browser window in front of you, or None."""
    win = hypr_browser_window()
    # Hyprland shows "<page title> - <Browser Name>"; tabs carry just the page.
    return win["title"] if win else None


# ------------------------------------------------------------------ page theme


def _theme_stamp_now():
    """Identity of the published theme — mtime of colors.toml and any override.

    Omarchy rewrites the whole current-theme directory on a switch, so mtime is
    enough; there is no in-place editing to miss.
    """
    stamp = []
    for path in (noren_theme.COLORS_FILE, noren_theme.THEME_OVERRIDE):
        try:
            stamp.append(os.stat(path).st_mtime_ns)
        except OSError:
            stamp.append(None)
    return tuple(stamp)


def load_theme(force=False):
    """Rebuild the stylesheets if the theme changed. Returns them, or None."""
    global _theme, _theme_stamp

    stamp = _theme_stamp_now()
    if not force and stamp == _theme_stamp and _theme is not None:
        return _theme

    try:
        built = noren_theme.build_css()
    except Exception as err:  # a broken palette must not take the bridge down
        log("theme build failed:", err)
        return _theme

    _theme_stamp = stamp
    if built:
        _theme = built
        log("theme loaded:", built["mode"], "themed" if built["themed"] else "generated")
    return _theme


def shatter_style_name(config):
    """The CLI's own reading of the setting, for the page that shows it."""
    value = config.get("shatter", False)   # off unless asked for; see the CLI
    if value is True:
        return "curtain"
    if value is False or value in ("off", "none", ""):
        return "off"
    return value if value in ("curtain", "glass") else "curtain"


_sites_stamp = None


def read_sites():
    """Per-site scripts, as the extension wants them: host -> {css, js, enabled}.

    The CLI writes these files; this only reads. They are handed to the page's
    own world, where nothing of Noren's is reachable, so the worst a bad one can
    do is break the site it belongs to.
    """
    try:
        with open(SITES_INDEX, "r") as fh:
            index = json.load(fh)
    except (OSError, ValueError):
        return {}
    if not isinstance(index, dict):
        return {}

    out = {}
    for host, entry in index.items():
        if not isinstance(entry, dict) or entry.get("enabled") is False:
            continue
        bundle = {"enabled": True}
        for kind in ("css", "js"):
            name = entry.get(kind)
            if not name:
                continue
            path = os.path.join(SITES_DIR, os.path.basename(str(name)))
            try:
                if os.path.getsize(path) > SITE_MAX_BYTES:
                    log("site script too large, skipping:", path)
                    continue
                with open(path, "r", errors="replace") as fh:
                    bundle[kind] = fh.read()
            except OSError:
                continue
        if bundle.get("css") or bundle.get("js"):
            out[host] = bundle
    return out


def sites_stamp():
    """Something that changes when any site script does."""
    try:
        stamps = [os.path.getmtime(SITES_INDEX)]
    except OSError:
        return None
    try:
        for name in sorted(os.listdir(SITES_DIR)):
            if name.endswith((".css", ".js")):
                stamps.append(os.path.getmtime(os.path.join(SITES_DIR, name)))
    except OSError:
        pass
    return tuple(stamps)


def push_sites():
    write_native({"type": "sites", "sites": read_sites()})


def push_config():
    """Hand the extension the settings it needs to honour.

    Only `search` so far: a typed phrase becomes a url in the extension too
    (navigate), and it must reach the same engine as the CLI's own path.
    """
    config = read_config()
    write_native({"type": "config", "search": config.get("search") or ""})


def set_pref(msg):
    """Change a CLI-owned setting, through the CLI."""
    name = str(msg.get("name") or "")
    make = PREF_COMMANDS.get(name)
    if not make:
        log("unknown preference:", name)
        return
    try:
        subprocess.run([NOREN_BIN] + make(msg.get("value")),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.SubprocessError) as exc:
        log("setting %s failed: %s" % (name, exc))
    push_config()


def push_theme():
    theme = load_theme()
    if theme:
        write_native({"type": "theme", "theme": theme})


# -------------------------------------------------------------------- wallpaper
#
# The start page sits on the desktop's own background, blurred behind glass. The
# extension cannot read files, so the host sends the image -- shrunk first: it is
# blurred on the page anyway, 1600px is plenty, and a native message may not
# exceed 1MB. Omarchy allows video backgrounds; for those, one frame stands in.

WALLPAPER_LINK = os.path.expanduser("~/.local/state/omarchy/current/background")
VIDEO_EXTENSIONS = (".mp4", ".webm", ".mkv", ".mov", ".avi", ".m4v")
_wallpaper_stamp = None
_wallpaper_lock = threading.Lock()


def _wallpaper_stamp_now():
    try:
        target = os.path.realpath(WALLPAPER_LINK)
        return (target, os.path.getmtime(target))
    except OSError:
        return None


def build_wallpaper(path):
    """A small JPEG of the background as a data: url, or None."""
    import base64
    import tempfile

    source = path
    frame = None
    try:
        if path.lower().endswith(VIDEO_EXTENSIONS):
            fd, frame = tempfile.mkstemp(suffix=".png", dir=os.environ.get("XDG_RUNTIME_DIR") or None)
            os.close(fd)
            subprocess.run(
                ["ffmpeg", "-v", "error", "-y", "-ss", "1", "-i", path, "-frames:v", "1", frame],
                check=True, timeout=20,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            source = frame
        # Shrink until it fits in a native message with room to spare.
        for size, quality in ((1600, 80), (1280, 72), (960, 65)):
            out = subprocess.run(
                ["magick", source + "[0]", "-resize", f"{size}x{size}>", "-strip",
                 "-quality", str(quality), "jpeg:-"],
                capture_output=True, timeout=20, check=True,
            ).stdout
            data = "data:image/jpeg;base64," + base64.b64encode(out).decode()
            if len(data) < 700_000:
                return data
    except (OSError, subprocess.SubprocessError) as exc:
        log("wallpaper build failed:", exc)
    finally:
        if frame and os.path.exists(frame):
            os.unlink(frame)
    return None


def push_wallpaper(force=False):
    """Send the background to the extension if it changed. Safe to call from any thread."""
    global _wallpaper_stamp
    with _wallpaper_lock:
        stamp = _wallpaper_stamp_now()
        if not force and stamp == _wallpaper_stamp:
            return
        _wallpaper_stamp = stamp
        data = build_wallpaper(stamp[0]) if stamp else None
    write_native({"type": "wallpaper", "data": data})
    log("wallpaper pushed" if data else "no wallpaper to push")


def watch_theme():
    """Re-push the stylesheets when the Omarchy theme changes.

    Polled rather than inotify: a theme switch is a human action a couple of
    times a day, the stat is two syscalls, and this avoids a dependency for
    something that would otherwise need one.
    """
    while True:
        time.sleep(2)
        if _theme_stamp_now() != _theme_stamp:
            log("omarchy theme changed")
            load_theme(force=True)
            push_theme()
        # A theme switch usually changes the background too, but cycling
        # backgrounds within a theme does not touch colors.toml at all.
        if _wallpaper_stamp_now() != _wallpaper_stamp:
            push_wallpaper()
        # Settings the extension honours, when they change from anywhere: the
        # CLI, the radial, or the start page.
        global _config_stamp
        try:
            stamp = os.path.getmtime(CONFIG_FILE)
        except OSError:
            stamp = None
        if stamp != _config_stamp:
            _config_stamp = stamp
            push_config()
        global _sites_stamp
        current = sites_stamp()
        if current != _sites_stamp:
            _sites_stamp = current
            push_sites()


# ---------------------------------------------------------------- socket server


def handle_client(conn):
    global _last_state, _sites_stamp
    with conn:
        buf = b""
        while b"\n" not in buf:
            chunk = conn.recv(4096)
            if not chunk:
                return
            buf += chunk
        try:
            req = json.loads(buf.split(b"\n", 1)[0])
        except json.JSONDecodeError:
            conn.sendall(b'{"ok":false,"error":"bad json"}\n')
            return

        cmd = req.pop("cmd", "")
        # Commands that act on "the window you're looking at" get a title hint
        # from Hyprland, since Chromium's own idea of focus is unreliable when
        # the call comes from a terminal or a keybind.
        if cmd in ("navigate", "back", "forward", "reload", "peel", "saveBookmark",
                   "extract", "inspect", "home", "toggleBar", "clipPick", "steal"):
            hint = hypr_target_title()
            if hint:
                req["matchTitle"] = hint

        if cmd == "theme":
            # Mode changes belong to the extension (it owns the injection and
            # the persisted setting); a bare `noren theme` reports.
            if req.get("mode"):
                reply = ask_extension("setThemeMode", mode=req["mode"])
            else:
                reply = ask_extension("themeStatus")
            theme = load_theme()
            if isinstance(reply, dict) and theme:
                reply["palette"] = theme["mode"]
                reply["themed"] = theme["themed"]
        elif cmd == "status":
            reply = {
                "ok": True,
                "state": _last_state,
                "autoPeel": _auto_peel,
                "themeMode": _theme_mode,
                "tabbed": bool(read_config().get("tabbed")),
                "browser": owning_browser(),
            }
        elif cmd == "open":
            spawn_window(req.get("url"))
            reply = {"ok": True}
        elif cmd == "reloadExtension":
            # Fire and forget: the extension dies mid-answer by design.
            write_native({"type": "command", "id": next(_ids), "cmd": "reloadSelf"})
            reply = {"ok": True}
        elif cmd == "applySite":
            # `noren site add` just wrote a file. The extension learns about
            # site scripts from a push, and its poll is seconds away -- so push
            # now, in front of the injection, or the page would be styled with
            # the script it had before (usually none).
            _sites_stamp = sites_stamp()
            push_sites()
            reply = ask_extension("applySite", host=req.get("host"))

        elif cmd == "bar":
            win = hypr_browser_window()
            if win and win.get("chromeless") and win.get("title"):
                reply = ask_extension("toggleBar", matchTitle=win["title"])
            else:
                reply = {"ok": False, "error": "no page in front of you"}
        elif cmd == "home":
            # Only a chrome-less page can go home. A tabbed window in front is
            # the extension's host, not a page, and a terminal is nothing.
            win = hypr_browser_window()
            if win and win.get("chromeless") and win.get("title"):
                reply = ask_extension("home", matchTitle=win["title"])
            else:
                reply = {"ok": False, "error": "no page in front of you"}
        elif cmd == "start":
            if spawn_start():
                reply = {"ok": True}
            else:
                reply = {"ok": False, "error": "no extension id -- run install.sh"}
        elif cmd == "goto":
            # What the url bar does on Enter. Navigate only when the thing in
            # front of you is actually a page; otherwise open a new chrome-less
            # window. Without this, typing a url while looking at a terminal
            # silently retargets whatever tabbed window is hosting the
            # extension — which is a host, not a browsing surface.
            win = hypr_browser_window()
            if win and win.get("chromeless"):
                reply = ask_extension(
                    "navigate", url=req.get("url"), matchTitle=win["title"]
                )
            else:
                spawn_window(req.get("url"))
                reply = {"ok": True, "spawned": True}
        else:
            reply = ask_extension(cmd, **req)
            # Say which browser is actually on the other end. A host outlives
            # nothing but its own browser, so when several are installed this
            # is the difference between "the bridge is up" and "the bridge is
            # up, attached to the browser you stopped using an hour ago".
            if cmd == "ping" and isinstance(reply, dict):
                reply["browser"] = owning_browser()
                reply["sinceLoad"] = int(time.monotonic() - _started)

        try:
            conn.sendall(json.dumps(reply).encode() + b"\n")
        except BrokenPipeError:
            pass


def serve():
    global _socket_inode
    if os.path.exists(SOCKET_PATH):
        os.unlink(SOCKET_PATH)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCKET_PATH)
    os.chmod(SOCKET_PATH, 0o600)
    # Remember which file is ours, so cleanup cannot delete a successor's.
    _socket_inode = os.stat(SOCKET_PATH).st_ino
    srv.listen(8)
    log("listening on", SOCKET_PATH)
    while True:
        try:
            conn, _ = srv.accept()
        except OSError:
            return
        threading.Thread(target=handle_client, args=(conn,), daemon=True).start()


# ------------------------------------------------------------------------ main


def cleanup():
    """Remove the socket however we exit — but only if it is still ours.

    A stale socket file is worse than none: connecting to it fails with
    ECONNREFUSED rather than ENOENT, so callers cannot tell 'browser closed'
    from 'something is broken'.

    The inode check matters when a host is cycled. The replacement binds a new
    socket at the same path while the outgoing one is still shutting down; an
    unconditional unlink here deletes the *new* host's socket, leaving it
    listening on a path nothing can reach. Compare inodes and only remove the
    file we actually created.
    """
    if _socket_inode is None:
        return
    try:
        if os.stat(SOCKET_PATH).st_ino == _socket_inode:
            os.unlink(SOCKET_PATH)
    except OSError:
        pass


def main():
    global _last_state, _auto_peel, _theme_mode

    atexit.register(cleanup)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda *_: sys.exit(0))

    threading.Thread(target=serve, daemon=True).start()

    # Build before the extension asks, so the first page load is already themed.
    load_theme(force=True)
    push_theme()
    push_config()
    push_sites()
    # Before the watcher starts, so it does not race this first push.
    threading.Thread(target=lambda: (push_wallpaper(force=True),
                                     watch_theme()), daemon=True).start()
    threading.Thread(target=watch_hyprland, daemon=True).start()

    while True:
        msg = read_native()
        if msg is None:
            break
        kind = msg.get("type")

        if kind == "reply":
            with _pending_lock:
                slot = _pending.get(msg.get("id"))
                if slot:
                    slot[1] = msg.get("data")
                    slot[0].set()

        elif kind == "state":
            _last_state = msg.get("state") or {}
            _auto_peel = bool(msg.get("autoPeel"))
            if msg.get("themeMode"):
                _theme_mode = msg["themeMode"]
            notify_shell(_last_state)

        elif kind == "spawn":
            # Tabbed mode: the new window joins the group of the page it came
            # from. Spawned first and folded after, never the other way round --
            # a peeled link leaves a full-chrome window on screen until its
            # replacement exists, so nothing may sit in front of the spawn.
            anchor, before = (tabbed_anchor() if read_config().get("tabbed") else (None, set()))
            spawn_window(msg.get("url"))
            if anchor:
                threading.Thread(target=join_spawned, args=(anchor, before), daemon=True).start()

        elif kind == "getGroup":
            grouped, members = group_members()
            write_native({"type": "group", "id": msg.get("id"),
                          "grouped": grouped, "members": members,
                          "switchMs": window_switch_ms()})

        elif kind == "raiseWindow":
            raise_member(msg.get("address"))

        elif kind == "getPrefs":
            config = read_config()
            write_native({"type": "prefs", "id": msg.get("id"), "prefs": {
                "tabbed": bool(config.get("tabbed")),
                "shatter": shatter_style_name(config),
                "search": config.get("search") or "",
            }})

        elif kind == "setPref":
            threading.Thread(target=set_pref, args=(msg,), daemon=True).start()

        elif kind == "getSets":
            # The start page lists sets but cannot read files; the worker asks
            # on its behalf.
            write_native({"type": "sets", "id": msg.get("id"), "sets": read_sets()})

        elif kind == "getSites":
            write_native({"type": "siteList", "id": msg.get("id"),
                          "sites": site_summary()})

        elif kind == "siteOp":
            threading.Thread(target=site_op, args=(msg,), daemon=True).start()

        elif kind == "openSet":
            open_set(msg.get("name"), replace=bool(msg.get("replace")))

        elif kind == "setOp":
            # Off the main loop: `set save` asks the extension for the open
            # windows through this host's socket, and that reply is read by
            # this very loop. Blocking here on the CLI would deadlock it.
            threading.Thread(target=set_op, args=(msg,), daemon=True).start()

        elif kind == "saveStart":
            save_start(msg.get("hidden"))

        elif kind == "toggleUrlBar":
            # From the reveal bar's address. The shell is the only thing that
            # can open the overlay; the extension cannot run a command.
            try:
                subprocess.Popen(
                    ["omarchy-shell", "-q", "shell", "toggle", PLUGIN_ID, "{}"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
            except OSError as exc:
                log("could not open the url bar:", exc)

        elif kind == "pageChanged":
            # A page navigated or finished loading; its snapshot is stale.
            threading.Timer(0.6, lambda: threading.Thread(
                target=snapshot_focused, daemon=True).start()).start()

        elif kind == "wantTheme":
            # The service worker restarts far more often than the host does.
            push_theme()

        elif kind == "error":
            log("extension error:", msg.get("message"))

    log("chromium closed the channel, exiting")
    if os.path.exists(SOCKET_PATH):
        os.unlink(SOCKET_PATH)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
