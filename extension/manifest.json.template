{
  "manifest_version": 3,
  "name": "Noren",
  "version": "0.1.0",
  "description": "Bridges Chromium to the Omarchy shell. Installed by Noren.",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "scripting",
    "bookmarks",
    "history",
    "webNavigation",
    "favicon"
  ],
  "background": {
    "service_worker": "background-30.js"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "bar.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
