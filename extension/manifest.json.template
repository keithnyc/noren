{
  "manifest_version": 3,
  "name": "Noren",
  "version": "0.1.0",
  "description": "Bridges Chromium to the Omarchy shell. Installed by Noren.",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background-10.js"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ]
}
