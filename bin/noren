#!/usr/bin/env python3
"""noren — drive the browser from the terminal, Hyprland binds, or the shell."""

import json
import os
import math
import re
import shutil
import socket
import subprocess
import sys
import threading
import time

# install.sh puts a symlink to this file on PATH, so every invocation a tester
# makes arrives through ~/.local/bin/noren. os.path.abspath does NOT resolve a
# symlink -- it returned ~/.local, and doctor then looked for the extension, the
# key and the theme module inside it and reported five failures telling the user
# to reinstall a perfectly good install. realpath is the whole fix; the constant
# exists so there is one place left to get it wrong.
NOREN_BIN = os.path.realpath(__file__)
NOREN_ROOT = os.path.dirname(os.path.dirname(NOREN_BIN))

SOCKET_PATH = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "noren.sock"
)

USAGE = """\
usage: noren <command> [args]

  goto <url>        navigate if you're looking at a page, else open a window
  start             send the page in front of you to the start page, or open one
  start --new       always open the start page in a new window
  start --keep      go to the start page without replacing the page in front
  bar               show or hide the reveal bar on the page in front of you
  bar on|off        whether pages get a reveal bar at all (persists)
  open <url>...     open each url as its own chrome-less window
  open --group ...  open them and fold them into one Hyprland group
  open --tiled ...  one window, even in tabbed mode
  clip              EXPERIMENTAL: point at part of the page in front of you;
                    it opens as a floating window showing only that, live
  clip <url> <css selector> [--width N]
                    the same, for an element you name
  tabbed on|off     new pages join the group in front, like tabs (persists)
