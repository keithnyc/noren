  search <url>      where typed words go, with %s for them (persists)
  watch             reload on every save: extension, host, and *.qml
  ask <question>    ask your Omarchy agent about the page in front of you
  ask --site <want> have it write a site script for this site
  ask --last        the last ask and its answer, as json
  agent             which agent Omarchy is set to, as json
  agent raise       bring that agent's terminal to the front
  log [-n N]        the host's recent activity: what it spawned, and why
  doctor            diagnose the whole chain end to end
  version           which Noren this is

The bridge runs only while your default browser is running with the Noren
extension loaded. It starts and stops with that browser.
"""


def default_browser():
    """Short name of the default browser. Omarchy exports BROWSER, which makes
    xdg-settings refuse to answer, so unset it the way omarchy's own scripts do."""
    try:
        out = subprocess.run(
            ["env", "-u", "BROWSER", "xdg-settings", "get", "default-web-browser"],
            capture_output=True, text=True, timeout=4,
        ).stdout.strip()
        return out.removesuffix(".desktop") or "your browser"
    except Exception:
        return "your browser"


def browser_running(name):
    try:
        subprocess.run(
            ["pgrep", "-x", name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True,
        )
        return True
    except Exception:
        return False


def no_bridge():
    """The host is started by the browser, so say which half is missing."""
    name = default_browser()
    if not browser_running(name):
        sys.exit(
            f"noren: {name} isn't running.\n"
            f"       The bridge starts with the browser — open {name} first."
        )
    sys.exit(
        f"noren: {name} is running but the extension hasn't connected.\n"
        f"       Restart it fully (pkill -x {name}) if you installed Noren\n"
        f"       while it was open, then check chrome://extensions."
    )



# Chromium's extensions::disable_reason bitmask. The one that matters here is
# the last: since M137 an unpacked extension is disabled unless Developer Mode
# is on, and nothing in the UI or on stderr says so.
DISABLE_REASONS = {
    1 << 0: "disabled by user",
    1 << 1: "permissions increase",
    1 << 2: "reload",
    1 << 3: "unsupported requirement",
    1 << 4: "sideload wipeout",
    1 << 7: "not verified",
    1 << 8: "greylisted",
    1 << 9: "corrupted",
    1 << 10: "remote install",
    1 << 11: "external extension",
    1 << 12: "update required by policy",
    1 << 14: "blocked by policy",
    1 << 16: "not allowlisted",
    1 << 17: "unsupported manifest version",
    1 << 24: "DEVELOPER MODE IS OFF (chrome://extensions -> Developer mode)",
}

OK, BAD, MEH = "  ok  ", " FAIL ", " warn "


def _row(status, label, detail=""):
    print(f"[{status}] {label}" + (f"  {detail}" if detail else ""))


def proc_cmdline(pid):
    """One flat bytes blob of a process's command line, or b"".

    Chromium rewrites its own argv in place to set process titles, which
    collapses the NUL separators into spaces -- so /proc/<pid>/cmdline comes
    back as a single field for exactly the processes we care about here.
    Splitting on NUL and testing `arg.startswith(b"--type=")` therefore never
    matches, which silently broke the helper-process filter below. Flatten
    first, then look for flags as substrings.
    """
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            return b" ".join(x for x in fh.read().split(b"\0") if x)
    except OSError:
        return b""


def browser_instances(ext_dir):
    """PIDs of browser processes (not helpers) that loaded Noren's extension."""
    pids = []
    try:
        entries = os.listdir("/proc")
    except OSError:
        return []
    for entry in entries:
        if not entry.isdigit():
            continue
        line = proc_cmdline(entry)
        if not line or ext_dir.encode() not in line:
            continue
        # Helper processes carry --type=; the browser process does not.
        if b"--type=" in line:
            continue
        pids.append(entry)
    return sorted(pids, key=int)


# What Noren was measured against. Everything in DEVELOPMENT.md -- and every
# `hl.dsp.*` signature, which came from Omarchy's own bindings.lua -- was
# verified here. A tester on a different Hyprland can have `gather` fail in a
# way that reads as a Noren bug, so doctor says the version out loud rather
# than leaving it to be guessed from a bug report.
TESTED_HYPRLAND = "0.56"


def host_versions():
    """(omarchy, hyprland), either possibly empty."""
    omarchy = ""
    try:
        out = subprocess.run(["omarchy", "version"], capture_output=True,
                             text=True, timeout=5)
        if out.returncode == 0:
            omarchy = out.stdout.strip().splitlines()[0].strip() if out.stdout.strip() else ""
    except (OSError, subprocess.SubprocessError, IndexError):
        pass
    if not omarchy:
        try:
            with open("/usr/share/omarchy/version") as fh:
                omarchy = fh.read().strip()
        except OSError:
            pass

    hypr = ""
    try:
        out = subprocess.run(["hyprctl", "version"], capture_output=True,
                             text=True, timeout=5)
        if out.returncode == 0:
            found = re.search(r"Hyprland\s+v?(\d+\.\d+(?:\.\d+)?)", out.stdout)
            if found:
                hypr = found.group(1)
    except (OSError, subprocess.SubprocessError):
        pass
    return omarchy, hypr


def doctor():
    here = NOREN_ROOT
    ext_dir = os.path.join(here, "extension")
    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    problems = 0

    _row(OK, "noren", f"{version()}  ({here})")

    omarchy_ver, hypr_ver = host_versions()
    if omarchy_ver:
        _row(OK, "omarchy", omarchy_ver)
    else:
        problems += 1
        _row(BAD, "omarchy", "not found - Noren is an Omarchy plugin")
    if not hypr_ver:
        _row(MEH, "hyprland", "not running - window commands will not work")
    elif hypr_ver.rsplit(".", 1)[0] == TESTED_HYPRLAND or hypr_ver == TESTED_HYPRLAND:
        _row(OK, "hyprland", f"{hypr_ver}  (what Noren was measured against)")
    else:
        _row(MEH, "hyprland",
             f"{hypr_ver} - Noren was measured against {TESTED_HYPRLAND}.x; if "
             f"gather/scatter misbehave, say this in the bug report")

    name = default_browser()
    if name == "chromium":
        _row(OK, "default browser", name)
    else:
        _row(MEH, "default browser",
             f"{name} - 0.01 is tested on Chromium only; say so in any bug report")

    running = browser_running(name)
    _row(OK if running else MEH, "browser running", "yes" if running else "no - start it")

    # One browser at a time, and one *instance* of it. Two Chromium processes
    # can both load the extension, but only one can own the native messaging
    # socket -- so every window in the other silently has no extension: nothing
    # peels there and `noren windows` cannot see them. This happened from a cold
    # multi-url open racing Chromium's singleton lock, and it is invisible
    # without looking at process arguments, which is exactly why it belongs here.
    browsers = browser_instances(ext_dir)
    if len(browsers) > 1:
        problems += 1
        _row(BAD, "browser instances",
             f"{len(browsers)} running (pids {', '.join(browsers)}) - only one owns "
             "the bridge; close them all and reopen")
    elif browsers:
        _row(OK, "browser instances", f"1 (pid {browsers[0]})")

    # Expected extension id, derived from the pinned key.
    try:
        want_id = open(os.path.join(here, "host", ".extid")).read().strip()
        _row(OK, "extension id", want_id)
    except OSError:
        want_id = None
        problems += 1
        _row(BAD, "extension id", "host/.extid missing - reinstall")

    # Service worker file actually referenced by the manifest.
    try:
        man = json.load(open(os.path.join(ext_dir, "manifest.json")))
        sw = man.get("background", {}).get("service_worker", "")
        exists = os.path.isfile(os.path.join(ext_dir, sw))
        if not exists:
            problems += 1
        _row(OK if exists else BAD, "service worker", sw + ("" if exists else " - FILE MISSING"))
    except Exception as exc:
        problems += 1
        _row(BAD, "extension manifest", str(exc))

    # Is the flag actually on the browser's command line?
    flags = os.path.join(cfg, f"{name}-flags.conf")
    in_flags = os.path.isfile(flags) and ext_dir in open(flags).read()
    if not in_flags:
        problems += 1
    _row(OK if in_flags else BAD, "--load-extension", os.path.basename(flags))

    # Native host manifest, and whether it is paired to the right id.
    nmh = os.path.join(cfg, name, "NativeMessagingHosts", "com.noren.bridge.json")
    if not os.path.isfile(nmh):
        nmh = os.path.join(cfg, "chromium", "NativeMessagingHosts", "com.noren.bridge.json")
    if os.path.isfile(nmh):
        origins = json.load(open(nmh)).get("allowed_origins", [])
        paired = any(want_id and want_id in o for o in origins)
        if not paired:
            problems += 1
        _row(OK if paired else BAD, "native host manifest",
             "paired" if paired else "id mismatch - reinstall")
    else:
        problems += 1
        _row(BAD, "native host manifest", "not found - run ./install.sh")

    # What the browser itself decided about the extension.
    prefs = os.path.join(cfg, name, "Default", "Preferences")
    if os.path.isfile(prefs):
        try:
            settings = json.load(open(prefs)).get("extensions", {}).get("settings", {})
            entry = settings.get(want_id)
            if entry is None:
                _row(MEH, "browser sees extension", "not yet - restart the browser")
            else:
                reasons = entry.get("disable_reasons") or []
                total = sum(reasons)
                if total:
                    problems += 1
                    named = [v for k, v in DISABLE_REASONS.items() if total & k] or [str(total)]
                    _row(BAD, "extension enabled", "NO - " + "; ".join(named))
                else:
                    _row(OK, "extension enabled", "yes")
        except Exception as exc:
            _row(MEH, "browser preferences", str(exc))
    else:
        _row(MEH, "browser preferences", "not found at " + prefs)

    # Page theming is independent of the bridge: it only needs Omarchy to have
    # published a palette, and the host to be able to turn it into CSS.
    try:
        sys.path.insert(0, os.path.join(here, "host"))
        import noren_theme

        if not os.path.exists(noren_theme.COLORS_FILE):
            _row(MEH, "omarchy palette", "no colors.toml - theming unavailable")
        else:
            built = noren_theme.build_css()
            if not built:
                problems += 1
                _row(BAD, "omarchy palette", "could not build a stylesheet")
            else:
                source = "theme-supplied" if built["themed"] else "generated"
                _row(OK, "page theme", f"{built['mode']} palette, {source}")
    except Exception as exc:
        problems += 1
        _row(BAD, "page theme", str(exc))

    # Completion still has to work with the browser closed, which is the first
    # summon of the day. If the profile cannot be read, the url bar is silently
    # empty until the browser happens to be open -- worth a row.
    marks = len(offline_bookmarks())
    visits = len(offline_history(limit=1))
    if marks or visits:
        _row(OK, "offline completion",
             f"{marks} bookmark(s), history "
             + ("readable" if visits else "locked (browser running)"))
    else:
        _row(MEH, "offline completion", "profile not readable - no completions "
             "while the browser is closed")

    # Settings that change how a window is spawned, since "why did that open
    # tiled?" is otherwise invisible.
    _row(OK, "tabbed mode", "on - new pages join the group in front"
         if tabbed_mode() else "off - new pages open as their own window")
    style = shatter_style()
    _row(OK, "shatter", f"{style} - how a closing page leaves" if style else "off")

    # The two symlinks the installer makes. Both are invisible until something
    # needs them, and both were missing on a machine installed before they
    # existed: a bare `noren` was not a command, and an agent asked to write a
    # site script spent minutes looking for a skill that was never linked.
    on_path = shutil.which("noren")
    if on_path:
        _row(OK, "noren on PATH", on_path)
    else:
        problems += 1
        _row(BAD, "noren on PATH",
             "not found - run install.sh, or link bin/noren into ~/.local/bin")

    skill_link = os.path.expanduser("~/.claude/skills/noren-site")
    if os.path.exists(skill_link):
        _row(OK, "site-script skill", skill_link)
    elif os.path.isdir(os.path.expanduser("~/.claude")):
        _row(MEH, "site-script skill",
             "not linked - agents will hunt for it; run install.sh")

    # And finally the live bridge.
    if os.path.exists(SOCKET_PATH):
        try:
            res = call({"cmd": "ping"})
            b = (res.get("browser") or {}).get("name", "?")
            _row(OK, "bridge", f"up - {b}")
        except SystemExit:
            problems += 1
            _row(BAD, "bridge", "socket present but not answering")
    else:
        problems += 1
        _row(BAD, "bridge", "no socket - extension has not connected")

    print()
    print("All good." if not problems else f"{problems} problem(s) above.")
    return 1 if problems else 0


def hypr_target():
    """The browser window in front of you, straight from Hyprland.

    Deliberately not routed through the host: the url bar needs this to render
    its hints, and it must work with the browser closed.

    Prefers the focused window. "First browser window on this workspace" held
    only while there was at most one -- `gather` puts several on a workspace and
    list order then picks an arbitrary member. The scan is the fallback for when
    the browser is not focused at all, and it skips hidden windows because the
    inactive members of a group sit behind the active one.
    """
    # Only the default browser's windows, plus any chrome-less window (those are
    # Noren's own). Another browser's window is one the bridge cannot drive.
    owner = default_browser().lower()

    def is_browser(c):
        cls = (c.get("class") or "").lower() if c else ""
        if not cls:
            return False
        return cls.startswith("chrome-") or (owner in cls)

    def describe(c):
        cls = c.get("class") or ""
        title = c.get("title") or ""
        return {
            "title": title.rsplit(" - ", 1)[0] if " - " in title else title,
            "app_id": cls,
            "chromeless": cls.lower().startswith("chrome-"),
        }

    def ask(what):
        try:
            return json.loads(subprocess.run(
                ["hyprctl", "-j", what],
                capture_output=True, text=True, timeout=3).stdout)
        except Exception:
            return None

    active = ask("activewindow") or {}
    if is_browser(active) and active.get("class"):
        return describe(active)

    ws_id = (ask("activeworkspace") or {}).get("id")
    here = [c for c in (ask("clients") or [])
            if is_browser(c) and c.get("workspace", {}).get("id") == ws_id]
    for c in here:
        if not c.get("hidden"):
            return describe(c)
    return describe(here[0]) if here else None


# ------------------------------------------------------- offline completions
#
# With the browser closed there is no bridge, so the extension cannot answer --
# and that is precisely the summon where completion helps most, the first one of
# the day. Chromium's own profile has both: `Bookmarks` is JSON and `History` is
# SQLite. The locking works out: History is locked while Chromium runs, which is
# exactly when this path is not needed.
#
# The ranking below is a second implementation of the extension's `scoreEntry`.
# Duplicating it is a real cost, accepted because the alternative is an empty
# url bar until the browser happens to be open. Keep the two in step.

WEBKIT_EPOCH_OFFSET = 11644473600  # seconds between 1601-01-01 and 1970-01-01


_running_profile = None


def running_profile_dir():
    """The profile directory of the browser that is actually running.

    Chromium keeps bookmarks and history inside whatever `--user-data-dir` it
    was launched with. Assuming the default one means a browser started on a
    different profile is offered *another* profile's data -- wrong, and it
    reads as a leak rather than a bug. Returns "" when the browser is not
    running or did not override the directory.
    """
    global _running_profile
    if _running_profile is not None:
        return _running_profile
    _running_profile = ""
    name = default_browser()
    if not name:
        return ""
    try:
        entries = os.listdir("/proc")
    except OSError:
        return ""
    for entry in entries:
        if not entry.isdigit():
            continue
        line = proc_cmdline(entry)
        if not line or b"--type=" in line:
            continue
        first = line.split(b" ", 1)[0]
        if name.encode() not in os.path.basename(first):
            continue
        data = re.search(rb"--user-data-dir=(\S+)", line)
        if not data:
            continue
        sub = re.search(rb"--profile-directory=(\S+)", line)
        _running_profile = os.path.join(
            data.group(1).decode("utf-8", "replace"),
            sub.group(1).decode("utf-8", "replace") if sub else "Default")
        break
    return _running_profile


def profile_dir():
    """Where the browser's own bookmarks and history live."""
    live = running_profile_dir()
    if live and os.path.isdir(live):
        return live
    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(cfg, default_browser(), "Default")


def offline_bookmarks():
    path = os.path.join(profile_dir(), "Bookmarks")
    try:
        with open(path, "r") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return []

    found = []

    def walk(node):
        if not isinstance(node, dict):
            return
        if node.get("type") == "url" and node.get("url"):
            found.append({"url": node["url"], "title": node.get("name") or ""})
        for child in node.get("children") or []:
            walk(child)

    for root in (data.get("roots") or {}).values():
        walk(root)
    return found


def offline_history(limit=400):
    path = os.path.join(profile_dir(), "History")
    if not os.path.exists(path):
        return []
    try:
        import sqlite3

        con = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        try:
            rows = con.execute(
                "SELECT url, title, visit_count, typed_count, last_visit_time "
                "FROM urls WHERE hidden = 0 ORDER BY visit_count DESC LIMIT ?",
                (limit,),
            ).fetchall()
        finally:
            con.close()
    except Exception:
        # Locked (browser running) or unreadable. Bookmarks alone is still
        # better than nothing.
        return []

    out = []
    for url, title, visits, typed, last in rows:
        out.append({
            "url": url,
            "title": title or "",
            "visitCount": visits or 0,
            "typedCount": typed or 0,
            # Chromium stores microseconds since 1601-01-01.
            "lastVisit": ((last or 0) / 1e6) - WEBKIT_EPOCH_OFFSET,
        })
    return out


def _offline_score(entry, needle):
    url = re.sub(r"^https?://", "", entry["url"]).lower().rstrip("/")
    title = entry["title"].lower()
    score = 120 if entry["kind"] == "bookmark" else 0

    if needle:
        if url.startswith(needle):
            score += 200
        elif ("/" + needle) in url:
            score += 60
        elif needle in url:
            score += 40
        if title.startswith(needle):
            score += 80
        elif needle in title:
            score += 30

    visits = entry.get("visitCount", 0)
    score += min(60, math.log2(1 + visits) * 12)
    # A url typed by hand is a stronger signal of intent than one merely visited.
    score += min(20, entry.get("typedCount", 0) * 4)

    last = entry.get("lastVisit", 0)
    if last > 0:
        days = (time.time() - last) / 86400.0
        score += max(0, 40 - days * 2)
    return score


# Link shorteners: every click on a social feed site goes through t.co, which makes it rank as a
# site you visit. Kept in step with PASS_THROUGH in the extension.
PASS_THROUGH = {"t.co", "bit.ly", "lnkd.in", "l.facebook.com", "out.reddit.com"}


def offline_start(limit=12):
    """The empty url bar with the browser closed: the bar, then most visited.

    Mirrors the extension's `places()`: one entry per site, its visits summed
    across pages, over the last 30 days, local dev servers excluded.
    """
    bar, bar_hosts = [], set()
    try:
        with open(os.path.join(profile_dir(), "Bookmarks"), "r") as fh:
            root = ((json.load(fh).get("roots") or {}).get("bookmark_bar") or {})
        for node in root.get("children") or []:
            url = node.get("url") or ""
            if node.get("type") == "url" and re.match(r"^https?://", url, re.I):
                bar.append({"url": url, "title": node.get("name") or "",
                            "kind": "bookmark", "visits": 0})
                bar_hosts.add(host_of(url).lower().removeprefix("www."))
    except (OSError, ValueError, AttributeError):
        pass

    # Hidden on the start page. The extension owns the list; the host mirrors it
    # here because this path runs with the browser, and its storage, closed.
    hidden = set()
    try:
        with open(os.path.join(os.path.dirname(SETS_FILE), "start.json"), "r") as fh:
            hidden = {str(h).lower() for h in (json.load(fh).get("hidden") or [])}
    except (OSError, ValueError, AttributeError):
        pass

    cutoff = time.time() - 30 * 86400
    sites = {}
    for visit in offline_history(limit=2000):
        url = visit["url"]
        if not re.match(r"^https?://", url, re.I) or visit["lastVisit"] < cutoff:
            continue
        host = host_of(url).lower().removeprefix("www.")
        if (not host or host == "localhost" or host.startswith("127.")
                or host in PASS_THROUGH or host in bar_hosts or host in hidden):
            continue
        site = sites.get(host)
        visits = visit["visitCount"]
        if site is None:
            sites[host] = {"url": url, "title": visit["title"], "best": visits, "visits": visits}
            continue
        site["visits"] += visits
        if visits > site["best"]:
            site.update(url=url, title=visit["title"] or site["title"], best=visits)

    top = sorted(sites.values(), key=lambda s: s["visits"], reverse=True)
    out = bar + [{"url": s["url"], "title": s["title"], "kind": "top", "visits": s["visits"]}
                 for s in top]
    return out[:limit]


def suggest_offline(query, kind=None, limit=8):
    needle = (query or "").strip().lower()
    pool = {}

    def add(entry, entry_kind):
        url = entry.get("url") or ""
        if not re.match(r"^https?://", url, re.I):
            return
        key = re.sub(r"^https?://", "", url).lower().rstrip("/")
        existing = pool.get(key)
        if existing:
            if entry_kind == "bookmark":
                existing["kind"] = "bookmark"
            for field in ("visitCount", "typedCount", "lastVisit"):
                existing[field] = max(existing.get(field, 0), entry.get(field, 0))
            if not existing["title"] and entry.get("title"):
                existing["title"] = entry["title"]
            return
        merged = dict(entry)
        merged["kind"] = entry_kind
        merged.setdefault("visitCount", 0)
        merged.setdefault("typedCount", 0)
        merged.setdefault("lastVisit", 0)
        pool[key] = merged

    if kind != "history":
        for mark in offline_bookmarks():
            add(mark, "bookmark")
    if kind != "bookmark":
        for visit in offline_history():
            add(visit, "history")

    rows = list(pool.values())
    if needle:
        rows = [
            r for r in rows
            if needle in re.sub(r"^https?://", "", r["url"]).lower()
            or needle in r["title"].lower()
        ]
    rows.sort(key=lambda r: _offline_score(r, needle), reverse=True)
    return [
        {"url": r["url"], "title": r["title"], "kind": r["kind"],
         "visits": r.get("visitCount", 0)}
        for r in rows[:limit]
    ]


# ----------------------------------------------------------------------- sets
#
# Named sets of pages that open together. The point is defining them without
# typing urls: you already have the windows arranged, so `noren set save news`
# takes what is open and names it. A set also remembers whether it was a group
# when saved, and comes back that way -- the shape is part of what you saved.

# ---------------------------------------------------------------- preferences
#
# One small file for settings that are neither the browser's (auto-peel, page
# theming -- those live in the extension, which owns them) nor a list of their
# own (sets.json, start.json). It is read by the CLI and by the host, so a
# setting that changes how a window is *spawned* applies wherever the spawn came
# from: the url bar, a peeled link, or a tile on the start page.

CONFIG_FILE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "noren", "config.json",
)


def load_config():
    try:
        with open(CONFIG_FILE, "r") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_config(config):
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(config, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, CONFIG_FILE)


DEFAULT_SEARCH = "https://duckduckgo.com/?q=%s"


def search_template():
    template = str(load_config().get("search") or "").strip()
    return template or DEFAULT_SEARCH


def search_url(text):
    """Where a typed phrase goes.

    `%s` is where the words land; a template without one has them appended, so
    both `https://example.com/search?q=%s` and `https://example.com/search?q=`
    do what they look like.
    """
    import urllib.parse

    query = urllib.parse.quote_plus(str(text or "").strip())
    template = search_template()
    return template.replace("%s", query) if "%s" in template else template + query


def tabbed_mode():
    return bool(load_config().get("tabbed"))


SETS_FILE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "noren", "sets.json",
)


def load_sets():
    try:
        with open(SETS_FILE, "r") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_sets(sets):
    os.makedirs(os.path.dirname(SETS_FILE), exist_ok=True)
    tmp = SETS_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(sets, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, SETS_FILE)


def open_page_urls():
    """Urls of the chrome-less windows currently open, in group order.

    Comes from the extension rather than Hyprland: `hyprctl` knows titles and
    classes, not urls. Group order is preferred over window order so a set
    reopens in the order its tab strip had.
    """
    res = call({"cmd": "windows"})
    urls = {}
    for win in (res.get("windows") or []):
        if win.get("type") != "app":
            continue
        tabs = win.get("tabs") or []
        # Web pages only. The start page is a chrome-less window too, and a set
        # that reopens Noren's own extension page is not a set of pages.
        if tabs and re.match(r"^https?://", tabs[0].get("url") or "", re.I):
            urls[tabs[0]["url"]] = True

    ordered = list(urls)
    # If those windows form a group, follow the group's own order.
    clients = {c.get("address"): c for c in (hypr_json("clients") or [])}
    grouped_addrs = []
    for client in clients.values():
        if (client.get("class") or "").startswith("chrome-") and client.get("grouped"):
            grouped_addrs = client["grouped"]
            break
    return ordered, bool(grouped_addrs)


def set_save(name):
    if not name:
        sys.exit("noren set save: needs a name")
    urls, grouped = open_page_urls()
    if not urls:
        sys.exit("noren set save: no chrome-less windows open to save")

    sets = load_sets()
    sets[name] = {
        "urls": urls,
        "grouped": grouped,
        "saved": time.strftime("%Y-%m-%dT%H:%M:%S"),
    }
    save_sets(sets)
    shape = "as a group" if grouped else "tiled"
    print(f"noren: saved set '{name}' — {len(urls)} page(s), {shape}")
    return 0


def set_preview(as_json=False):
    """What `set save` would capture right now.

    Exists for the overlay: the url bar offers to save the open pages under a
    typed name, and it should show what it is about to save rather than a count
    with no evidence.
    """
    try:
        urls, grouped = open_page_urls()
    except SystemExit:
        urls, grouped = [], False
    if as_json:
        print(json.dumps({"urls": urls, "grouped": grouped}))
        return 0
    if not urls:
        print("noren: no chrome-less windows open")
        return 0
    shape = "as a group" if grouped else "tiled"
    print(f"noren: {len(urls)} page(s), {shape}")
    for url in urls:
        print("  " + url)
    return 0


def set_list(as_json=False):
    sets = load_sets()
    if as_json:
        print(json.dumps(sets, indent=2, sort_keys=True))
        return 0
    if not sets:
        print("noren: no sets yet — open some pages and run `noren set save <name>`")
        return 0
    for name in sorted(sets):
        entry = sets[name] or {}
        urls = entry.get("urls") or []
        hosts = ", ".join(host_of(u) for u in urls[:4])
        if len(urls) > 4:
            hosts += f", +{len(urls) - 4} more"
        shape = "group" if entry.get("grouped") else "tiled"
        print(f"{name:<16} {len(urls):>2} page(s)  {shape:<6} {hosts}")
    return 0


def host_of(url):
    m = re.match(r"^[a-z][a-z0-9+.-]*://([^/?#]+)", str(url or ""), re.I)
    return (m.group(1) if m else str(url))[:40].replace("www.", "")


def set_open(name, force_group=None, replace=False):
    """Open a set -- alongside what is open, or in place of the page in front.

    Replacing turns the focused chrome-less window into the set's first page
    and, for a grouped set, folds the rest into it, so the page a set was opened
    from is not left behind. It falls back to opening alongside when there is
    nothing to replace, or when the page in front already belongs to a group:
    replacing a member would pour the set into a group it has nothing to do with.
    """
    sets = load_sets()
    entry = sets.get(name)
    if not entry:
        known = ", ".join(sorted(sets)) or "none"
        sys.exit(f"noren set open: no set '{name}' (have: {known})")
    urls = entry.get("urls") or []
    if not urls:
        sys.exit(f"noren set open: set '{name}' is empty")
    group = entry.get("grouped", False) if force_group is None else force_group

    if replace:
        # The focused window exactly -- not "some page on this workspace".
        active = hypr_json("activewindow") or {}
        cls = (active.get("class") or "").lower()
        addr = active.get("address")
        in_group = len(active.get("grouped") or []) > 1
        if not addr or not cls.startswith("chrome-") or not bridge_up():
            print("noren: no page in front to replace; opening alongside")
        elif in_group:
            print("noren: the page in front is in a group; opening alongside")
        else:
            res = call({"cmd": "navigate", "url": urls[0]})
            if res.get("ok") is False:
                print(f"noren: could not replace ({res.get('error')}); opening alongside")
            else:
                rest = urls[1:]
                if not rest:
                    return 0
                return open_many(rest, group=group, join=addr if group else None)

    return open_many(urls, group=group)


SET_NAME_MAX = 40


def set_put(payload):
    """Create or replace a set from JSON, for the start page's editor.

    {"name": ..., "urls": [...], "grouped": bool, "previous": old name or null}

    `previous` makes a rename one atomic write rather than a save and a delete
    that can half-happen. Read from stdin rather than argv: urls carry `&` and
    `#`, and a name could start with `-`.
    """
    if not isinstance(payload, dict):
        sys.exit("noren set put: expected a JSON object")
    name = str(payload.get("name") or "").strip()
    previous = payload.get("previous")
    previous = str(previous).strip() if previous else None
    if not name:
        sys.exit("noren set put: a set needs a name")
    if len(name) > SET_NAME_MAX or any(c in name for c in "\n\t,") or name.startswith("@"):
        sys.exit(f"noren set put: names are up to {SET_NAME_MAX} characters, "
                 "without commas or a leading @")

    urls, seen = [], set()
    for raw in payload.get("urls") or []:
        url = normalize(raw)
        if not url:
            sys.exit(f"noren set put: not a web address: {raw!r}")
        if url not in seen:
            seen.add(url)
            urls.append(url)
    if not urls:
        sys.exit("noren set put: a set needs at least one page")

    sets = load_sets()
    if previous and previous not in sets:
        sys.exit(f"noren set put: no set '{previous}' to rename")
    if name in sets and name != previous:
        sys.exit(f"noren set put: there is already a set called '{name}'")
    if previous and previous != name:
        del sets[previous]
    sets[name] = {
        "urls": urls,
        "grouped": bool(payload.get("grouped")),
        "saved": time.strftime("%Y-%m-%dT%H:%M:%S"),
    }
    save_sets(sets)
    print(f"noren: saved set '{name}' — {len(urls)} page(s)")
    return 0


def set_remove(name):
    sets = load_sets()
    if name not in sets:
        sys.exit(f"noren set rm: no set '{name}'")
    del sets[name]
    save_sets(sets)
    print(f"noren: removed set '{name}'")
    return 0


# -------------------------------------------------------------- window identity

APPLICATIONS_DIR = os.path.expanduser("~/.local/share/applications")


def app_id_for(url, profile="Default"):
    """The app_id Chromium will give an `--app=<url>` window.

    `--class` is ignored on Wayland, so this is not a choice -- it is a
    prediction, and a wrong one matches nothing while looking correct.

    The rule is host, an underscore, then the path with slashes as underscores.
    Note that DEVELOPMENT.md's prose ("/ replaced by _") does not account for
    the separator and disagrees with its own example: a root path yields *two*
    underscores, as in `chrome-news.example.com__-Default`, which is what
    every window observed on this machine does too.
    """
    raw = str(url or "").strip().strip('"').strip("'")
    m = re.match(r"^[a-z][a-z0-9+.-]*://([^/?#]+)([^?#]*)", raw, re.I)
    if not m:
        return None
    host, path = m.group(1), m.group(2) or "/"
    if not path.startswith("/"):
        path = "/" + path
    return f"chrome-{host}_{path.replace('/', '_')}-{profile}"


def live_app_ids():
    """Classes of chrome-less windows open right now, as ground truth."""
    return {
        (c.get("class") or "")
        for c in (hypr_json("clients") or [])
        if (c.get("class") or "").startswith("chrome-")
    }


def observed_app_id(url, live):
    """A live window's class for this url's host, if one is open.

    Preferred over the prediction wherever available: the only authority on what
    Chromium calls a window is Chromium.
    """
    guess = app_id_for(url)
    if not guess:
        return None
    if guess in live:
        return guess
    host = guess[len("chrome-"):].split("_", 1)[0]
    prefix = f"chrome-{host}_"
    matches = sorted(c for c in live if c.startswith(prefix))
    return matches[0] if len(matches) == 1 else None


def desktop_webapps():
    """Launchers that open a url through omarchy-launch-webapp."""
    out = []
    try:
        names = sorted(os.listdir(APPLICATIONS_DIR))
    except OSError:
        return out
    for name in names:
        if not name.endswith(".desktop"):
            continue
        path = os.path.join(APPLICATIONS_DIR, name)
        try:
            with open(path, "r") as fh:
                text = fh.read()
        except OSError:
            continue
        if "omarchy-launch-webapp" not in text:
            continue
        url = None
        swc = None
        for line in text.splitlines():
            if line.startswith("Exec=") and "omarchy-launch-webapp" in line:
                url = line.split("omarchy-launch-webapp", 1)[1].strip()
                url = url.strip('"').strip("'").split()[0] if url else None
            elif line.startswith("StartupWMClass="):
                swc = line.split("=", 1)[1].strip()
        if url:
            out.append({"path": path, "name": name[: -len(".desktop")],
                        "url": url, "swc": swc, "text": text})
    return out


def apps_report():
    live = live_app_ids()
    apps = desktop_webapps()
    if not apps:
        print("noren: no webapp launchers found in " + APPLICATIONS_DIR)
        return 0

    print(f"{'app':<20} {'app_id':<44} state")
    for app in apps:
        seen = observed_app_id(app["url"], live)
        want = seen or app_id_for(app["url"])
        if app["swc"] == want:
            state = "set" + (" (confirmed by a live window)" if seen else " (predicted)")
        elif app["swc"]:
            state = f"MISMATCH - has {app['swc']}"
        else:
            state = "not set" + (" (confirmed)" if seen else " (predicted)")
        print(f"{app['name']:<20} {str(want):<44} {state}")
    print()
    print("A predicted app_id is unverified until that app has been opened once;")
    print("`noren apps` confirms it against the live window. `noren apps adopt`"
          " writes them.")
    return 0


def apps_adopt(only=None, revert=False):
    live = live_app_ids()
    apps = desktop_webapps()
    touched = 0

    for app in apps:
        if only and app["name"].lower() != only.lower():
            continue
        want = observed_app_id(app["url"], live) or app_id_for(app["url"])
        if not want:
            print(f"noren: cannot derive an app_id for {app['name']}", file=sys.stderr)
            continue

        lines = app["text"].splitlines()
        has = [i for i, l in enumerate(lines) if l.startswith("StartupWMClass=")]

        if revert:
            # Only remove what we would have written. A value someone else set
            # deliberately is theirs, not ours to clean up.
            removable = [i for i in has if lines[i].split("=", 1)[1].strip() == want]
            if not removable:
                continue
            for i in reversed(removable):
                lines.pop(i)
            action = "removed StartupWMClass from"
        else:
            if has and lines[has[0]].split("=", 1)[1].strip() == want:
                continue
            if has:
                lines[has[0]] = f"StartupWMClass={want}"
            else:
                # Into [Desktop Entry], after the last key of that section.
                insert_at = len(lines)
                in_entry = False
                for i, l in enumerate(lines):
                    if l.strip().startswith("["):
                        if in_entry:
                            insert_at = i
                            break
                        in_entry = l.strip() == "[Desktop Entry]"
                    elif in_entry and l.strip():
                        insert_at = i + 1
                lines.insert(insert_at, f"StartupWMClass={want}")
            action = "set StartupWMClass on"

        body = "\n".join(lines)
        if not body.endswith("\n"):
            body += "\n"
        try:
            with open(app["path"], "w") as fh:
                fh.write(body)
        except OSError as err:
            print(f"noren: could not write {app['path']}: {err}", file=sys.stderr)
            continue
        touched += 1
        print(f"noren: {action} {app['name']} ({want})")

    if touched == 0:
        print("noren: nothing to change")
    return 0


# ------------------------------------------------------------------ hyprland
#
# Every dispatcher goes through the Lua API. The legacy string form is gone on
# this Hyprland (0.56.2): `hyprctl dispatch submap reset` is a syntax error,
# only `hl.dsp.submap("reset")` works -- which also makes the legacy fallback in
# `omarchy-launch-or-focus` dead code here. Signatures below are taken from
# Omarchy's own bindings.lua rather than guessed: moving a window into a group
# is `window.move({into_group=...})`, not anything under `group`.


def hypr_json(what):
    try:
        return json.loads(subprocess.run(
            ["hyprctl", "-j", what],
            capture_output=True, text=True, timeout=3).stdout)
    except Exception:
        return None


def hypr_do(expr):
    try:
        out = subprocess.run(["hyprctl", "dispatch", expr],
                             capture_output=True, text=True, timeout=3)
        return out.stdout.strip()
    except Exception:
        return ""


def hypr_focus(address):
    hypr_do(f'hl.dsp.focus({{ window = "address:{address}" }})')


def hypr_event_socket():
    """Hyprland's event stream, or None.

    Waiting for a window to appear used to be a 0.2s poll of `hyprctl clients`;
    this says so the moment it happens. The socket is hidden (`.socket2.sock`),
    which is easy to miss when looking for it.
    """
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not sig or not runtime:
        return None
    path = os.path.join(runtime, "hypr", sig, ".socket2.sock")
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.connect(path)
        return sock
    except OSError:
        return None


def wait_for_chromeless(before, count=1, timeout=8.0, events=None):
    """Addresses of `count` chrome-less windows that were not there before.

    Prefers the event stream -- `openwindow` carries the address and class -- and
    falls back to polling where there is no socket. `events` is a socket opened
    *before* whatever spawns the window, so nothing can be missed in between.
    """
    before = set(before)
    fresh = chromeless_addresses() - before
    own_socket = events is None
    if len(fresh) >= count:
        return fresh
    if own_socket:
        events = hypr_event_socket()
    if events is None:
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            time.sleep(0.05)
            fresh = chromeless_addresses() - before
            if len(fresh) >= count:
                break
        return fresh

    deadline = time.monotonic() + timeout
    buffer = b""
    try:
        while time.monotonic() < deadline:
            events.settimeout(max(0.05, deadline - time.monotonic()))
            try:
                chunk = events.recv(4096)
            except socket.timeout:
                break
            if not chunk:
                break
            buffer += chunk
            while b"\n" in buffer:
                line, buffer = buffer.split(b"\n", 1)
                text = line.decode("utf-8", "replace")
                if not text.startswith("openwindow>>"):
                    continue
                parts = text[len("openwindow>>"):].split(",", 3)
                if len(parts) < 3 or not parts[2].lower().startswith("chrome-"):
                    continue
                address = "0x" + parts[0]
                if address not in before:
                    fresh.add(address)
            if len(fresh) >= count:
                break
    finally:
        if own_socket:
            events.close()
    return fresh


def wait_mapped(address, timeout=0.6):
    """Block until a window has a real size, so Hyprland can be asked to move it.

    Replaces a flat settle. A window that is still being mapped reports a zero
    size, and moving it then is what left windows outside the group.
    """
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        for client in hypr_json("clients") or []:
            if client.get("address") == address:
                size = client.get("size") or [0, 0]
                if size and size[0] > 0 and size[1] > 0:
                    return True
        time.sleep(0.02)
    return False


def noren_windows(pattern=None):
    """Chrome-less windows Noren made, newest last.

    Only `chrome-<host>-<profile>` app_ids: an ordinary tabbed window has class
    `chromium`, and gathering that would drag the extension's host window into a
    group with the pages. Nothing outside this prefix is ever touched.
    """
    clients = hypr_json("clients") or []
    wins = [c for c in clients
            if (c.get("class") or "").lower().startswith("chrome-")]
    if pattern:
        want = pattern.lower()
        wins = [c for c in wins
                if want in (c.get("class") or "").lower()
                or want in (c.get("title") or "").lower()]
    return wins


def gather(pattern=None, only=None, anchor_address=None):
    """Pull peeled windows back into one Hyprland group -- the return path.

    `peel` scatters and nothing brought them back, which makes a week of
    tabs-as-windows a one-way trip. The group bar then acts as the tab strip
    (SUPER+Tab is `group.active`), which is the whole premise.
    """
    wins = noren_windows(pattern)
    if only is not None:
        wanted = set(only)
        wins = [w for w in wins if w.get("address") in wanted]
    # Floating windows stay where they are: a clip is a widget, and grouping
    # one turns it back into a page; any other floated page was set aside on
    # purpose. The radial's Gather count skips them for the same reason.
    floating = [w for w in wins if w.get("floating")]
    wins = [w for w in wins if not w.get("floating")]
    if not wins:
        print("noren: no chrome-less windows to gather"
              + (f" matching '{pattern}'" if pattern else "")
              + (f" ({len(floating)} floating, left alone)" if floating else ""))
        return 1
    if len(wins) == 1:
        print("noren: only one window; nothing to gather")
        return 0

    ws = hypr_json("activeworkspace") or {}
    active_ws = ws.get("id")
    started_on = (hypr_json("activewindow") or {}).get("address")

    # Anchor on this workspace if there is one, so gather pulls pages *to* you.
    # A caller that knows which window the group belongs to -- a set replacing
    # the page you were on -- names it instead.
    anchor = next((c for c in wins if c.get("address") == anchor_address), None) \
        or next((c for c in wins if c.get("workspace", {}).get("id") == active_ws), wins[0])
    target_ws = anchor.get("workspace", {}).get("id")
    others = [c for c in wins if c["address"] != anchor["address"]]

    # The anchor has to be a group before anything can join it.
    hypr_focus(anchor["address"])
    made_group = not anchor.get("grouped")
    if made_group:
        hypr_do("hl.dsp.group.toggle()")

    def try_fold(win):
        addr = win["address"]
        hypr_focus(addr)
        if win.get("workspace", {}).get("id") != target_ws:
            # follow=false keeps the focus from being dragged across workspaces
            # on every iteration.
            hypr_do(f'hl.dsp.window.move({{ workspace = "{target_ws}", follow = false }})')
            hypr_focus(addr)

        # into_group takes a direction, not a target, so which way the group
        # lies depends on how the layout tiled these windows. Head toward where
        # the group actually is rather than trying all four blindly: a wrong
        # direction is not free, it moves the window somewhere else first, and
        # the next attempt then starts from a worse position.
        rect = _rect(hypr_json("activewindow") or {}) or _rect(win)
        for direction in _fold_order(rect, _rect(anchor)):
            hypr_do(f'hl.dsp.window.move({{ into_group = "{direction}" }})')
            # Confirmation as it happens, rather than a flat wait: `grouped` is
            # the only honest answer, and checking immediately once read a
            # successful fold as a failure -- which sent the window off in three
            # more directions.
            if _wait_grouped(addr):
                return True
            rect = _rect(hypr_json("activewindow") or {}) or rect
        return False

    # Several passes, because one is not enough. With four or five windows the
    # layout can leave one of them diagonal to the group -- adjacent in no
    # cardinal direction at all -- and a single pass simply skips it. Every
    # successful fold reflows the workspace and changes what is adjacent to
    # what, so the stragglers are worth retrying. Stop as soon as a pass folds
    # nothing, rather than spinning on a window that genuinely cannot reach.
    moved = 0
    pending = list(others)
    for _ in range(4):
        if not pending:
            break
        remaining = []
        for win in pending:
            if try_fold(win):
                moved += 1
            else:
                remaining.append(win)
        if len(remaining) == len(pending):
            break
        pending = remaining
    stuck = pending

    if started_on:
        hypr_focus(started_on)

    # Not locked, deliberately. A locked group is exactly what stops a terminal
    # joining it, but Hyprland paints a locked group's bar with
    # `group:col.border_locked_active` -- default 66ff5500, orange, which Omarchy
    # never overrides. Buying the behaviour costs a red tab bar, and fixing the
    # colour means writing global Hyprland config, which this plugin does not do.
    # If you want the behaviour, set `group { auto_group = false }` in your own
    # looknfeel.lua and nothing will auto-join anything.
    print(f"noren: gathered {moved} of {len(others)} window(s) into a group")
    for win in stuck:
        print(f"       left out: {(win.get('title') or win.get('class'))[:60]}")
    return 0


def _is_grouped(address):
    for c in hypr_json("clients") or []:
        if c.get("address") == address:
            return bool(c.get("grouped"))
    return False


def _rect(client):
    """(centre x, centre y) of a client, or None."""
    at = (client or {}).get("at") or None
    size = (client or {}).get("size") or None
    if not at or not size or len(at) < 2 or len(size) < 2:
        return None
    return (at[0] + size[0] / 2.0, at[1] + size[1] / 2.0)


def _fold_order(window_centre, anchor_centre):
    """Directions to try, likeliest first: toward where the group is."""
    everything = ("l", "r", "u", "d")
    if not window_centre or not anchor_centre:
        return everything
    dx = anchor_centre[0] - window_centre[0]
    dy = anchor_centre[1] - window_centre[1]
    first = ("l" if dx < 0 else "r") if abs(dx) >= abs(dy) else ("u" if dy < 0 else "d")
    return (first,) + tuple(d for d in everything if d != first)


def _wait_grouped(address, budget=0.25):
    """Whether a just-moved window landed in a group, checked as it happens.

    This used to be a flat 0.12s sleep before a single look, which every
    successful fold paid in full and every failed direction paid again. The
    window was focused to move it, so `activewindow` answers -- a smaller
    payload than the whole client list, for the same cost per call.
    """
    deadline = time.monotonic() + budget
    while True:
        active = hypr_json("activewindow") or {}
        if active.get("address") == address and len(active.get("grouped") or []) > 1:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.02)


def front_window():
    """The chrome-less window in front of you, as a full client record.

    Both group dispatchers act on whatever Hyprland calls *active*, and both are
    normally invoked from the radial menu -- whose overlay is on screen at the
    time. So the target is resolved here and focused explicitly rather than
    assumed; guessing wrong ungroups a different group than the one you meant.

    The `hidden` check below carries less weight than it looks: measured
    2026-09-12, Hyprland reports `hidden: false` for *both* members of a
    two-window group, so it does not mark inactive group members. It still
    filters genuinely hidden windows, but the real work is done by preferring
    the active window above.
    """
    clients = hypr_json("clients") or []
    by_address = {c.get("address"): c for c in clients}

    active = hypr_json("activewindow") or {}
    target = by_address.get(active.get("address"))
    if target and (target.get("class") or "").lower().startswith("chrome-"):
        return target

    ws_id = (hypr_json("activeworkspace") or {}).get("id")
    for c in noren_windows():
        if c.get("workspace", {}).get("id") == ws_id and not c.get("hidden"):
            return c
    return None


def pop():
    """Lift the window in front of you out of its group, leaving the rest.

    `gather` is all-or-nothing and `scatter` undoes the lot; this is the middle
    case -- you grouped everything, then wanted one of them back out.
    """
    target = front_window()
    if not target:
        print("noren: no chrome-less window in front of you")
        return 1
    if len(target.get("grouped") or []) < 2:
        print("noren: that window is not in a group")
        return 1

    hypr_focus(target["address"])
    hypr_do("hl.dsp.window.move({ out_of_group = true })")
    title = (target.get("title") or target.get("class") or "")[:60]
    print(f"noren: popped out {title}")
    return 0


def raise_window(address):
    """Focus a window by Hyprland address, and say whether it took.

    Exists because the overview needs it and `Hyprland.dispatch` from Quickshell
    proved unreliable for this -- it worked once and silently did nothing twice.
    Everything else the radial menu does already shells out through this CLI, so
    this keeps one dispatch path rather than two, and this one is verified.
    """
    hex_part = re.sub(r"[^0-9a-fA-F]", "", str(address or "").replace("0x", "", 1))
    if not hex_part:
        sys.exit("noren raise: needs a window address")
    addr = "0x" + hex_part

    known = {c.get("address") for c in (hypr_json("clients") or [])}
    if addr not in known:
        sys.exit(f"noren raise: no window at {addr}")

    hypr_focus(addr)
    now = (hypr_json("activewindow") or {}).get("address")
    if now != addr:
        print(f"noren: focus did not take — still on {now}", file=sys.stderr)
        return 1
    return 0


def scatter():
    """Break the group in front of you back into ordinary tiled windows.

    This dissolves the *whole* group -- every member becomes its own tiled
    window. `pop` is the one-window version.
    """
    target = front_window()
    if not target:
        print("noren: no chrome-less window in front of you")
        return 1
    members = target.get("grouped") or []
    if len(members) < 2:
        print("noren: that window is not in a group")
        return 1

    hypr_focus(target["address"])
    hypr_do("hl.dsp.group.toggle()")
    print(f"noren: scattered {len(members)} windows into tiles")
    return 0


def normalize(url):
    """Match the host's rule: --app= needs an absolute URL or it is ignored.

    Anything that is not a destination is a search. Without this, typing words
    into the url bar and pressing Enter opened a window at `https://two words`,
    which fails quietly and looks like Noren losing the input.
    """
    raw = str(url or "").strip()
    if not raw:
        return None
    if re.match(r"^https?://", raw, re.I):
        return raw
    if re.match(r"^[a-z][a-z0-9+.-]*:", raw, re.I):
        return None
    if not looks_like_destination(raw):
        return search_url(raw)
    return "https://" + raw


def looks_like_destination(text):
    """A token that is a place to go rather than something to search for."""
    raw = str(text or "").strip()
    if not raw or " " in raw:
        return False
    return bool(re.match(r"^[a-z][a-z0-9+.-]*://", raw, re.I)) or "." in raw


def split_urls(args):
    """Split `social.example, search.example video.example` into destinations.

    Comma is the separator. It only *counts* as one when every part is itself a
    destination -- `bread, butter recipe` is a search, and splitting it would
    open two windows for a phrase someone meant to look up. The rule lives here
    rather than in the overlay so the CLI and the url bar cannot disagree.
    """
    raw = [str(a).strip() for a in args if str(a).strip()]
    if not raw:
        return []

    # Several argv entries that are all destinations: the shell already split
    # them, as in `noren open social.example search.example`.
    if len(raw) > 1 and all(looks_like_destination(a) for a in raw):
        out = []
        for arg in raw:
            out.extend(p.strip() for p in arg.split(",") if p.strip())
        return out

    joined = " ".join(raw)
    if "," not in joined:
        return [joined]

    parts = [p.strip() for p in joined.split(",") if p.strip()]
    if len(parts) > 1 and all(looks_like_destination(p) for p in parts):
        return parts
    return [joined]


def bridge_up():
    """Whether the host socket is there *and* answering."""
    if not os.path.exists(SOCKET_PATH):
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
            probe.settimeout(1.0)
            probe.connect(SOCKET_PATH)
        return True
    except OSError:
        return False


def wait_for_bridge(timeout=25.0):
    """Block until the browser has started and its extension has connected."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if bridge_up():
            return True
        time.sleep(0.4)
    return False


def chromeless_addresses():
    return {w.get("address") for w in noren_windows()}


def front_chromeless():
    """The chrome-less window a new page should join, or None.

    The focused window only. "Some page on this workspace" would pull a new
    window into a group the user is not looking at, which is worse than leaving
    it tiled.
    """
    active = hypr_json("activewindow") or {}
    cls = (active.get("class") or "").lower()
    return active if cls.startswith("chrome-") and active.get("address") else None


def join_new(anchor_address, before, timeout=8.0):
    """Wait for a chrome-less window that is not in `before`, and tab it.

    Split out because the two spawn paths cannot share one: the url bar's
    `open` waits for its own window, while a peeled link is spawned by the host
    as fast as it can (the flash a peel leaves on screen lasts exactly as long
    as that spawn), and the fold has to happen afterwards, out of the way.
    """
    fresh = wait_for_chromeless(before, count=1, timeout=timeout)
    if not fresh:
        print("noren: nothing new appeared to tab")
        return 0
    if anchor_address not in chromeless_addresses():
        print("noren: the page to tab it with is gone; leaving it tiled")
        return 0
    for address in fresh:
        wait_mapped(address)
    return gather(only=fresh | {anchor_address}, anchor_address=anchor_address)


def spawn_and_join(spawn, tabbed=None):
    """Run `spawn`, and in tabbed mode fold the window it makes into the group.

    Every way of making a page window goes through here -- a url, a tile, the
    start page -- so "new pages are tabs" means all of them and not just the
    one it was written for. The fold is the same `gather` the G key uses: one
    code path touches groups.
    """
    if tabbed is None:
        tabbed = tabbed_mode()
    anchor = front_chromeless() if tabbed else None
    before = chromeless_addresses() if anchor else set()
    # Listening before the spawn, so the window cannot appear in the gap
    # between opening it and starting to watch for it.
    events = hypr_event_socket() if anchor else None

    try:
        result = spawn()
        if not anchor:
            return result
        fresh = wait_for_chromeless(before, count=1, events=events)
    finally:
        if events:
            events.close()

    if not fresh:
        print("noren: opened it, but the window did not appear in time to tab it")
        return result
    for address in fresh:
        wait_mapped(address)
    gather(only=fresh | {anchor["address"]}, anchor_address=anchor["address"])
    return result


def clip(args):
    """EXPERIMENTAL: a floating window that shows one element of a page, live.

    With no arguments, point at it on the page in front of you. With a url and
    a selector, open that directly -- which is how isolation was first tested.
    """
    width = 0
    if "--width" in args:
        i = args.index("--width")
        try:
            width = int(args[i + 1])
        except (IndexError, ValueError):
            sys.exit("noren clip: --width needs a number")
        args = args[:i] + args[i + 2:]
    if not args or args == ["pick"]:
        return pick_clip()
    if len(args) < 2:
        sys.exit("usage: noren clip [<url> <css selector> [--width N]]")
    return open_clip(args[0], " ".join(args[1:]), width)


def pick_clip():
    """Point at part of the page in front of you, then open it as a clip."""
    res = call({"cmd": "clipPick"})
    if res.get("ok") is False:
        sys.exit(f"noren clip: {res.get('error', 'failed')}")
    # The pick is the user's to take their time over. Poll rather than hold one
    # call open: the bridge times a call out in seconds.
    deadline = time.monotonic() + 120
    while time.monotonic() < deadline:
        time.sleep(0.2)
        got = (call({"cmd": "pickResult"}) or {}).get("pick") or {}
        if got.get("cancelled"):
            return 0
        if got.get("selector"):
            return open_clip(got["url"], got["selector"], int(got.get("width") or 0),
                              heading=got.get("heading", ""), tag=got.get("tag", ""),
                              height=int(got.get("height") or 0))
    print("noren clip: nothing picked")
    return 1


def open_clip(url, selector, width=0, heading="", tag="", height=0):
    if not re.match(r"^https?://", url, re.I):
        url = "https://" + url
    print(f"noren clip: {selector}" + (f"  ('{heading}')" if heading else ""))

    before = chromeless_addresses()
    events = hypr_event_socket()
    try:
        res = call({"cmd": "clip", "url": url, "selector": selector, "width": width,
                    "heading": heading, "tag": tag, "height": height})
        if res.get("ok") is False:
            sys.exit(f"noren clip: {res.get('error', 'failed')}")
        fresh = wait_for_chromeless(before, count=1, timeout=10, events=events)
    finally:
        if events:
            events.close()
    if not fresh:
        sys.exit("noren clip: the window did not appear")
    address = sorted(fresh)[0]
    wait_mapped(address, timeout=3)

    # Wait for the page to find its clip. A framework may render it late.
    info = None
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        got = (call({"cmd": "clipInfo"}) or {}).get("clip")
        if got and got.get("found"):
            info = got
            break
        time.sleep(0.25)
    if not info:
        print(f"noren clip: '{selector}' not found on the page -- left it as a plain window")
        return 1

    # The height it was picked at, when there is one: the new window measures
    # while the page is still filling in (a list of five measured as three).
    # A video's own shape wins over both.
    tall = info["height"] if info.get("video") or not height else height
    place_clip(address, info["width"], tall)
    print(f"noren clip: {info['width']}x{info['height']} from {url}")
    return 0


def place_clip(address, width, height):
    """Float, size and centre one window -- checked before anything is sent."""
    client = next((c for c in hypr_json("clients") or [] if c.get("address") == address), None)
    if not client or not (client.get("class") or "").lower().startswith("chrome-"):
        print("noren clip: the window went away before it could be placed")
        return
    # Every dispatch below names its window, but the rule here is to confirm
    # the target anyway: a wrong address must never land on the terminal.
    hypr_focus(address)
    if (hypr_json("activewindow") or {}).get("address") != address:
        print("noren clip: could not focus the new window; left it where it is")
        return

    # Hyprland opens a new window *into* the focused group, and floating a
    # grouped window floats the whole group -- the first test of this floated
    # and shrank two of the user's own pages along with the clip. So the clip
    # leaves the group first, and nothing is floated unless it is alone.
    if len(client.get("grouped") or []) >= 2:
        hypr_do("hl.dsp.window.move({ out_of_group = true })")
        time.sleep(0.15)
        client = next((c for c in hypr_json("clients") or []
                       if c.get("address") == address), None) or {}
        if len(client.get("grouped") or []) >= 2:
            print("noren clip: the window opened inside a group and would not leave it;"
                  " left it there rather than float the whole group")
            return
        hypr_focus(address)
        if (hypr_json("activewindow") or {}).get("address") != address:
            print("noren clip: lost focus leaving the group; left it where it is")
            return

    mon = next((m for m in hypr_json("monitors") or [] if m.get("id") == client.get("monitor")), {})
    scale = mon.get("scale") or 1
    max_w = int((mon.get("width") or 1920) / scale * 0.9)
    max_h = int((mon.get("height") or 1080) / scale * 0.85)
    w, h = max(120, min(int(width), max_w)), max(80, min(int(height), max_h))

    win = f"address:{address}"
    if not client.get("floating"):
        hypr_do(f'hl.dsp.window.float({{ window = "{win}", action = "toggle" }})')
    hypr_do(f'hl.dsp.window.resize({{ window = "{win}", x = {w}, y = {h} }})')
    hypr_do(f'hl.dsp.window.center({{ window = "{win}" }})')


def open_one(url, tabbed=None):
    """Open one url, as a tab of the page in front when tabbed mode is on."""
    def spawn():
        res = call({"cmd": "open", "url": url}, fallback=lambda: spawn_direct(url))
        if res.get("ok") is False:
            sys.exit(f"noren: {res.get('error', 'failed')}")
        return 0

    return spawn_and_join(spawn, tabbed=tabbed)


def open_many(urls, group=False, join=None):
    """Open each url as its own chrome-less window, optionally as one group.

    `join` is the address of a window already showing the first page: the new
    windows are grouped with it, and it anchors the group.

    Grouping cannot be fired straight after the spawns: the windows do not exist
    yet. Wait for them to actually appear, then fold in only the ones that were
    not there before -- gathering everything would drag in whatever was already
    open, which is not what was asked for.
    """
    before = chromeless_addresses() if group else set()

    # From a cold start these must be serialised. With the browser closed every
    # url falls back to `omarchy-launch-webapp`, and two of those firing in the
    # same instant race Chromium's singleton lock: both win, and you end up with
    # two independent browser processes. Only one can own the native messaging
    # socket, so every window in the other has no working extension -- nothing
    # peels there, and `noren windows` cannot even see them. Observed exactly
    # once, with two browsers started in the same second.
    #
    # So: launch the first, wait for its extension to connect, then send the
    # rest through the bridge, which spawns them from the browser that already
    # exists.
    total = len(urls)
    cold = not bridge_up()
    if cold:
        first, urls = urls[0], urls[1:]
        try:
            spawn_direct(first)
        except SystemExit:
            print(f"noren: could not open {first!r}", file=sys.stderr)
        if not wait_for_bridge():
            print("noren: browser did not come up; opening the rest may start a "
                  "second one", file=sys.stderr)

    for url in urls:
        try:
            call({"cmd": "open", "url": url}, fallback=lambda u=url: spawn_direct(u))
        except SystemExit:
            # One bad url should not strand the rest.
            print(f"noren: could not open {url!r}", file=sys.stderr)

    if not group:
        print(f"noren: opening {total} window(s)")
        return 0

    fresh = wait_for_chromeless(before, count=total, timeout=8.0)

    members = fresh | ({join} if join else set())
    if len(members) < 2:
        print(f"noren: opened {total} window(s); too few appeared to group")
        return 0

    # Each window must have a real size before Hyprland is asked to move it.
    for address in fresh:
        wait_mapped(address)
    return gather(only=members, anchor_address=join)


START_TITLE = "Noren Start"


def extension_id():
    here = NOREN_ROOT
    try:
        with open(os.path.join(here, "host", ".extid"), "r") as fh:
            ext_id = fh.read().strip()
    except OSError:
        return None
    return ext_id if ext_id.isalpha() else None


# ----------------------------------------------------------------- dev watch
#
# The three reload paths, run for you. Which one a file needs is a property of
# the file, not a decision worth making on every save -- and forgetting one
# looks exactly like the change not working, which is the oldest way to lose an
# hour on this project.

WATCH_SHELL = (".qml",)
WATCH_BROWSER = (".js", ".html", ".css", ".json")


def watch_files(root):
    """Every file worth watching, with its mtime."""
    seen = {}
    for folder in (root, os.path.join(root, "extension"), os.path.join(root, "host")):
        try:
            entries = list(os.scandir(folder))
        except OSError:
            continue
        for entry in entries:
            if not entry.is_file():
                continue
            name = entry.name
            watched = (
                name.endswith(WATCH_SHELL)
                or (folder.endswith("extension") and name.endswith(WATCH_BROWSER))
                or name in ("noren-host", "noren_theme.py")
                or (folder == root and name == "manifest.json")
            )
            if not watched:
                continue
            try:
                seen[entry.path] = entry.stat().st_mtime
            except OSError:
                pass
    return seen


def needs_shell(path):
    return path.endswith(WATCH_SHELL) or os.path.basename(path) == "manifest.json"


def watch():
    """Reload whatever changed, on save, until Ctrl+C."""
    root = NOREN_ROOT
    state = watch_files(root)
    print(f"noren watch: {len(state)} files under {root}", flush=True)
    print("             *.qml and manifest.json -> omarchy-restart-shell", flush=True)
    print("             extension/ and host/    -> reload-extension", flush=True)
    print("             Ctrl+C to stop.", flush=True)

    while True:
        time.sleep(0.4)
        now = watch_files(root)
        changed = [p for p, m in now.items() if state.get(p) != m]
        changed += [p for p in state if p not in now]
        if not changed:
            continue

        # Let the flurry end first: an editor writing three files, or writing
        # one of them twice, is one change to react to.
        while True:
            time.sleep(0.25)
            settled = watch_files(root)
            if settled == now:
                break
            now = settled
        state = now

        names = sorted({os.path.basename(p) for p in changed})
        print(f"[{time.strftime('%H:%M:%S')}] {', '.join(names)}", flush=True)

        if any(needs_shell(p) for p in changed):
            print("           omarchy-restart-shell", flush=True)
            subprocess.run(["omarchy-restart-shell"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if any(not needs_shell(p) for p in changed):
            if not bridge_up():
                print("           browser is closed; nothing to reload", flush=True)
            else:
                res = call({"cmd": "reloadExtension"})
                message = ("extension reloaded" if res.get("ok")
                           else res.get("error", "failed"))
                print("           " + message, flush=True)


SHATTER_STYLES = ("curtain", "glass")


def shatter_style():
    """How a page window leaves: "curtain", "glass", or None for plainly.

    A noren is a split curtain in a doorway, so a page parting into panels and
    falling is the house style; glass is the other one. Older configs stored a
    bool, when there was only one.

    Off unless asked for. The animation hears about a close only after the
    window is gone, so it arrives ~100-135ms late, behind Hyprland's own close
    animation -- a visible flick, then the panels. See DEVELOPMENT.md.
    """
    value = load_config().get("shatter", False)
    if value is True:
        return "curtain"
    if value is False or value in ("off", "none", ""):
        return None
    return value if value in SHATTER_STYLES else "curtain"


# ------------------------------------------------------------------- sites
#
# Per-site scripts and styles: "make this site behave the way I want". Written
# by hand or by the user's agent (see the skill in `skills/`), kept as plain
# files that can be read, disabled and deleted.
#
# What keeps them safe is where they run, not what they promise: the extension
# injects them into the *page's own world*, where there are no extension APIs at
# all. A site script cannot reach the bridge, the host, the CLI or any of
# Noren's state; the worst it can do is make one site look wrong, which
# `noren site off` undoes. One host each, never on Noren's own pages.

SITES_DIR = os.path.join(os.path.dirname(SETS_FILE), "sites")
SITES_INDEX = os.path.join(SITES_DIR, "index.json")


def noren_root():
    """Where Noren itself lives -- this file's checkout or plugin directory."""
    return NOREN_ROOT


def version():
    """The one place the version is written down. install.sh copies it into the
    extension manifest, so a tester reporting a bug and the extension Chromium
    actually loaded cannot disagree."""
    try:
        with open(os.path.join(noren_root(), "VERSION")) as fh:
            return fh.read().strip() or "unknown"
    except OSError:
        return "unknown"


def skill_path():
    """The site-script skill, as a path an agent can read without looking."""
    path = os.path.join(noren_root(), "skills", "noren-site", "SKILL.md")
    return path if os.path.exists(path) else ""
SITE_MAX_BYTES = 128 * 1024
# Not a sandbox -- the world is the sandbox. These are a shove in the ribs for
# the reviewer: a site script that talks to the network is doing something other
# than styling a page.
SITE_SUSPICIOUS = ("fetch(", "XMLHttpRequest", "import(", "navigator.sendBeacon",
                   "WebSocket", "eval(", "document.cookie", "localStorage")


def site_host(text):
    """`x.example`, from a host, a url, or something close to either."""
    raw = str(text or "").strip().lower()
    if not raw:
        return ""
    raw = re.sub(r"^[a-z][a-z0-9+.-]*://", "", raw)
    raw = raw.split("/")[0].split("?")[0].split("#")[0]
    raw = raw.split("@")[-1].split(":")[0]
    raw = raw.removeprefix("www.")
    return raw if re.match(r"^[a-z0-9.-]+\.[a-z]{2,}$", raw) else ""


def load_sites():
    try:
        with open(SITES_INDEX, "r") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_sites(index):
    os.makedirs(SITES_DIR, exist_ok=True)
    tmp = SITES_INDEX + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(index, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, SITES_INDEX)


def site_files(host):
    return (os.path.join(SITES_DIR, host + ".css"),
            os.path.join(SITES_DIR, host + ".js"))


def site_check(path):
    """Refuse what should not be installed; warn about what deserves a look."""
    try:
        size = os.path.getsize(path)
    except OSError:
        sys.exit(f"noren site: cannot read {path}")
    if size > SITE_MAX_BYTES:
        sys.exit(f"noren site: {os.path.basename(path)} is {size} bytes; "
                 f"the limit is {SITE_MAX_BYTES}")
    with open(path, "r", errors="replace") as fh:
        body = fh.read()

    if path.endswith(".js") and shutil.which("node"):
        checked = subprocess.run(["node", "--check", path],
                                 capture_output=True, text=True)
        if checked.returncode != 0:
            sys.exit("noren site: that script does not parse\n"
                     + checked.stderr.strip())

    found = sorted({token for token in SITE_SUSPICIOUS if token in body})
    return found


def front_page_host():
    """The site of the page in front of you, for the commands that default to it."""
    active = hypr_json("activewindow") or {}
    cls = (active.get("class") or "").lower()
    if not cls.startswith("chrome-"):
        return ""
    if bridge_up():
        state = call({"cmd": "status"}).get("state") or {}
        found = site_host(state.get("url") or "")
        if found:
            return found
    # `chrome-x.example__-Default` carries the host when the bridge is not up.
    return site_host(re.sub(r"^chrome-", "", cls).split("__")[0].replace("_", "/"))


def site_inspect(host=None):
    """What the page in front of you is made of, for whoever writes the script.

    Selectors guessed from the outside are the reason site scripts rot. This
    reads the live page -- the one you are logged into -- and prints a structural
    outline: the landmarks, what is big, and how to name them.
    """
    if not bridge_up():
        sys.exit("noren site inspect: the browser is not running")
    target = site_host(host) if host else front_page_host()
    if not target:
        sys.exit("noren site inspect: no page in front of you; name a site")
    res = call({"cmd": "inspect", "host": target})
    if res.get("ok") is False:
        sys.exit(f"noren: {res.get('error', 'failed')}")
    print(json.dumps(res.get("outline") or {}, indent=2)[:200000])
    return 0


def site_shot(host=None):
    """A screenshot of that site's window, so a change can be looked at."""
    target = site_host(host) if host else front_page_host()
    if not target:
        sys.exit("noren site shot: no page in front of you; name a site")
    for win in noren_windows():
        cls = (win.get("class") or "").lower()
        at = win.get("at") or []
        size = win.get("size") or []
        if target.replace(".", "_") not in cls.replace(".", "_"):
            continue
        if len(at) < 2 or len(size) < 2:
            continue
        path = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp",
                            f"noren-shot-{target}.png")
        try:
            done = subprocess.run(
                ["grim", "-g", f"{at[0]},{at[1]} {size[0]}x{size[1]}", path],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        except (OSError, subprocess.SubprocessError) as exc:
            sys.exit(f"noren site shot: {exc}")
        if done.returncode != 0:
            sys.exit("noren site shot: grim could not capture that window")
        print(path)
        return 0
    sys.exit(f"noren site shot: no open window for {target}")


def site_add(host, path, kind=None):
    host = site_host(host)
    if not host:
        sys.exit("noren site add: needs a site, like x.example")
    if not path or not os.path.exists(path):
        sys.exit("noren site add: needs a file to install")
    kind = kind or ("css" if path.endswith(".css") else "js")
    if kind not in ("css", "js"):
        sys.exit("noren site add: a site script is .css or .js")

    warnings = site_check(path)
    css_path, js_path = site_files(host)
    target = css_path if kind == "css" else js_path
    os.makedirs(SITES_DIR, exist_ok=True)
    shutil.copyfile(path, target)

    index = load_sites()
    entry = index.get(host) or {}
    entry["enabled"] = True
    entry[kind] = os.path.basename(target)
    entry["updated"] = time.strftime("%Y-%m-%dT%H:%M:%S")
    index[host] = entry
    save_sites(index)

    print(f"noren: installed {kind} for {host} -> {target}")
    for token in warnings:
        print(f"       note: uses {token} — read it before trusting it")
    print("       it runs in the page's own world: no access to Noren, "
          "the bridge, or your data")
    site_apply(host)
    return 0


def site_list(as_json=False):
    index = load_sites()
    if as_json:
        print(json.dumps(index, indent=2, sort_keys=True))
        return 0
    if not index:
        print("noren: no site scripts yet")
        return 0
    for host in sorted(index):
        entry = index[host] or {}
        parts = [kind for kind in ("css", "js") if entry.get(kind)]
        state = "on " if entry.get("enabled", True) else "off"
        when = str(entry.get("updated") or "").replace("T", " ")[:16]
        print(f"{state} {host:<28} {', '.join(parts) or '(nothing)':<9} {when}")
        # The paths, because the next thing anyone asks is "what does it do?"
        for path in site_files(host):
            if os.path.exists(path):
                print(f"      {path}")
    return 0


def site_apply(host, quiet=False):
    """Run an installed script on the pages that are already open.

    Installing a script used to change nothing until the user reloaded, which
    is indistinguishable from a script that does not work -- and it is what
    happened the first time an agent wrote one: it reported success over an
    unchanged page. So the install ends here, on the live page.

    Nothing to do when the browser is closed: the script is on disk, and the
    next page load picks it up.
    """
    host = site_host(host)
    if not host:
        return 0
    if not bridge_up():
        if not quiet:
            print("       browser closed — it runs when that page next opens")
        return 0
    res = call({"cmd": "applySite", "host": host}, fallback=lambda: {"ok": False})
    if quiet:
        return 0
    if res.get("ok") and res.get("applied"):
        pages = res["applied"]
        print(f"       running on {pages} open page{'' if pages == 1 else 's'}")
    elif res.get("ok"):
        print(f"       nothing open on {host} — it runs when you go there")
    return 0


def site_toggle(host, on):
    host = site_host(host)
    index = load_sites()
    if host not in index:
        sys.exit(f"noren site: nothing installed for {host or '?'}")
    index[host]["enabled"] = on
    save_sites(index)
    print(f"noren: {host} {'on' if on else 'off'}")
    if on:
        site_apply(host)
    else:
        # A script that has already run cannot be un-run: css could be pulled
        # back out, js could not, so both wait for a reload rather than half
        # of the change vanishing and the other half staying.
        print("       reload the page to get it back as the site made it")
    return 0


def site_remove(host):
    host = site_host(host)
    index = load_sites()
    if host not in index:
        sys.exit(f"noren site: nothing installed for {host or '?'}")
    for path in site_files(host):
        try:
            os.unlink(path)
        except OSError:
            pass
    del index[host]
    save_sites(index)
    print(f"noren: removed {host}")
    return 0


# --------------------------------------------------------------------- ask
#
# Hand the page in front of you to the user's own agent -- whichever one they
# chose in Omarchy. Noren supplies what they cannot type: the rendered page they
# are logged into, its structure, and where to put the answer.
#
# The agent runs in its own terminal, because that is where its approvals and
# tool output belong; wrapping every agent CLI's stream in our own chat window
# would fight the interface the user picked. What comes back to Noren is a
# single answer file, which the overlay renders when it appears.

# The page in front of you goes through here -- its url, its title, whatever you
# had selected, its text. XDG_RUNTIME_DIR is already private to one user; the
# fallback must be too, so never /tmp, where the next user along can read it.
ASK_DIR = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR")
    or os.environ.get("XDG_CACHE_HOME")
    or os.path.join(os.path.expanduser("~"), ".cache"),
    "noren-ask")


def ask_dir():
    """ASK_DIR, made if it is missing, readable only by its owner."""
    os.makedirs(ASK_DIR, mode=0o700, exist_ok=True)
    try:
        os.chmod(ASK_DIR, 0o700)
    except OSError:
        pass
    return ASK_DIR


def default_agent():
    try:
        out = subprocess.run(["omarchy-default-agent"], capture_output=True,
                             text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return ""
    return out.stdout.strip() if out.returncode == 0 else ""


def page_text():
    """The page in front of you, as the extension sees it."""
    if not bridge_up():
        sys.exit("noren ask: the browser is not running")
    res = call({"cmd": "extract"})
    if res.get("ok") is False:
        sys.exit(f"noren: {res.get('error', 'failed')}")
    return res.get("page") or {}


def ask(question, want_site=False, dry_run=False):
    """Put a question about this page to the agent, and say where the answer goes."""
    agent = default_agent()
    if not agent:
        sys.exit("noren ask: no default agent set — run `omarchy default agent`")

    page = page_text()
    url = page.get("url") or ""
    host = site_host(url)
    if not url:
        sys.exit("noren ask: no page in front of you")

    ask_dir()
    stamp = time.strftime("%H%M%S")
    context_path = os.path.join(ASK_DIR, f"page-{stamp}.md")
    answer_path = os.path.join(ASK_DIR, f"answer-{stamp}.md")
    status_path = os.path.join(ASK_DIR, f"status-{stamp}.txt")
    # Something to show the moment the panel shrinks, before the agent has had
    # a chance to say anything of its own.
    with open(status_path, "w") as fh:
        fh.write("waking your agent")

    context = [
        f"# {page.get('title') or host}",
        f"<{url}>",
        "",
    ]
    if page.get("selection"):
        context += ["## The user's selection", "", page["selection"], ""]
    context += ["## Page text", "", page.get("text") or "(the page had no text)"]
    if page.get("truncated"):
        context += ["", "_(truncated)_"]
    with open(context_path, "w") as fh:
        fh.write("\n".join(context))

    noren_bin = NOREN_BIN
    skill = skill_path()
    # The one line that turns a spinner into a narration. Overwrite rather than
    # append, because the panel shows the file, not a log -- and asking for
    # progress in the prompt works with whichever agent Omarchy is set to,
    # where parsing twelve different CLIs' output would not.
    narrate = (
        f"As you go, keep {status_path} up to date: overwrite it (never append) "
        f"with one short line, five or six words, present tense, naming what "
        f"you are doing right now -- \"reading the page\", \"writing the "
        f"stylesheet\", \"checking how it looks\". Noren shows that line to "
        f"them while they wait, and it is the only thing they can see from "
        f"here. "
    )
    # Where the skill is, spelled out. The agent starts in a terminal that knows
    # nothing about Noren: the first attempt said "read the skill `noren-site`"
    # and the agent spent minutes searching the filesystem for it.
    skill_line = (
        f"Read {skill} first -- it is short, and it carries the rules you must "
        f"follow. "
        if skill else
        "Follow the noren-site skill's rules if you have it. "
    )

    if want_site:
        outline = call({"cmd": "inspect", "host": host}).get("outline") or {}
        outline_path = os.path.join(ASK_DIR, f"outline-{stamp}.json")
        with open(outline_path, "w") as fh:
            json.dump(outline, fh, indent=2)
        prompt = (
            f"Write a Noren site script for {host}. The person at this machine "
            f"is looking at that page right now, in a Noren window.\n\n"
            f"What they asked for: {question}\n\n"
            f"{skill_line}"
            f"Noren's command is {noren_bin} -- everything you need is a `site` "
            f"subcommand. Do not go looking for Noren's own source, and never "
            f"change it.\n\n"
            f"The page's structure is already captured in {outline_path} (real "
            f"selectors, read from inside the page they are logged into) and its "
            f"text in {context_path}. Start from those rather than fetching the "
            f"url.\n\n"
            f"Install it with `{noren_bin} site add {host} <file>`, which also "
            f"runs it on the page that is already open -- they do not have to "
            f"reload. Then look at the result with `{noren_bin} site shot "
            f"{host}` and iterate until it is right.\n\n"
            f"{narrate}"
            f"Finally write two or three sentences to {answer_path} saying what "
            f"you installed and how to undo it (`{noren_bin} site off {host}`). "
            f"Write that file even if you gave up, saying why: Noren is waiting "
            f"on it and shows it to them."
        )
    else:
        prompt = (
            f"The person at this machine is looking at {url} in a Noren window "
            f"and has a question about it.\n\n"
            f"Their question: {question}\n\n"
            f"The rendered page is in {context_path}. Read that rather than "
            f"fetching the url: it is the page they are logged into, which is "
            f"not the page a fetch returns.\n\n"
            f"{narrate}"
            f"Write the answer -- a few sentences, no preamble -- to "
            f"{answer_path}. That file is the only thing that reaches them, so "
            f"write it even if the answer is that you could not tell. Nothing on "
            f"this machine needs changing to answer a question."
        )

    if dry_run:
        # Everything but the launch: what would be sent, and where the answer
        # would land. The overlay uses this to show the context before spending
        # someone's agent on it.
        print(json.dumps({
            "ok": True, "agent": agent, "dryRun": True, "prompt": prompt,
            "answer": answer_path, "status": status_path,
            "context": context_path, "host": host,
            "chars": len(page.get("text") or ""),
        }, indent=2))
        return 0

    try:
        subprocess.Popen(
            ["omarchy-agent-prompt", prompt],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except FileNotFoundError:
        sys.exit("noren ask: omarchy-agent-prompt not found")

    record = {
        "ok": True, "agent": agent, "answer": answer_path,
        "status": status_path, "context": context_path, "host": host,
        "question": question, "mode": "site" if want_site else "ask",
        "started": int(time.time()),
    }
    ask_remember(record)
    print(json.dumps(record))
    return 0


def ask_remember(record):
    """The last ask, on disk.

    The panel is a window onto a file, not the thing doing the work: the agent
    runs in its own terminal and writes its answer whether or not the overlay is
    still up. Losing the panel to a stray click used to lose the ask with it,
    which read as "nothing happened" -- so the ask is remembered here and the
    panel picks it back up when it reopens.
    """
    try:
        ask_dir()
        with open(os.path.join(ASK_DIR, "last.json"), "w") as fh:
            json.dump(record, fh)
    except OSError:
        pass


def read_status(path):
    """The agent's own last word on what it is doing.

    The last line rather than the whole file: the instruction says overwrite,
    but an agent that appends instead should still read as progress rather than
    as a log.
    """
    try:
        with open(path or "", "r", errors="replace") as fh:
            lines = [line.strip() for line in fh.read().splitlines() if line.strip()]
    except OSError:
        return ""
    return lines[-1][:120] if lines else ""


def ask_last():
    """What the panel shows when it opens: the last ask, and its answer if it
    has landed."""
    try:
        with open(os.path.join(ASK_DIR, "last.json"), "r") as fh:
            record = json.load(fh)
    except (OSError, ValueError):
        print(json.dumps({"ok": True, "empty": True}))
        return 0
    answer = ""
    try:
        with open(record.get("answer") or "", "r", errors="replace") as fh:
            answer = fh.read().strip()
    except OSError:
        answer = ""
    record["answerText"] = answer
    record["done"] = bool(answer)
    record["statusText"] = read_status(record.get("status"))
    print(json.dumps(record))
    return 0


AGENT_CLASS = "org.omarchy.agent"


def agent_window():
    """The agent's own terminal, if one is open.

    Omarchy launches every agent with one app id, so this finds the terminal
    whichever agent is set. The most recently focused one when there are
    several: that is the one this ask started, or near enough that raising it
    is what the user meant.
    """
    best = None
    for client in hypr_json("clients") or []:
        if (client.get("class") or "").lower() != AGENT_CLASS:
            continue
        if best is None or client.get("focusHistoryID", 99) < best.get("focusHistoryID", 99):
            best = client
    return best


def agent_raise():
    """Put the agent's terminal in front -- the panel's `watch` affordance.

    Waits a moment for one to appear: the click usually comes seconds after the
    ask, and a terminal that is still starting would otherwise look like a
    button that does nothing.
    """
    for _ in range(12):
        win = agent_window()
        if win and win.get("address"):
            return raise_window(win["address"])
        time.sleep(0.2)
    print("noren: no agent terminal open")
    return 0


def ask_sweep():
    """Old questions and answers are clutter; they live in the runtime dir."""
    try:
        cutoff = time.time() - 6 * 3600
        for name in os.listdir(ASK_DIR):
            path = os.path.join(ASK_DIR, name)
            if os.path.getmtime(path) < cutoff:
                os.unlink(path)
    except OSError:
        pass


def close_window():
    """Close the page in front of you.

    Nothing special happens here any more, and that is the point: the host
    watches Hyprland's own close event and plays the animation for every close,
    whoever made it -- SUPER + W, a page closing itself, this. Noren asking for
    the close key would have been the wrong trade: the compositor stays in
    charge, which is the whole premise.
    """
    hypr_do("hl.dsp.window.close()")
    return 0


def start_page(new=False, keep=False):
    """Go home: the page in front of you becomes the start page.

    Like a browser's Home button, and like a tile click, which also navigates
    in place. Only when there is no page in front of you -- a terminal, the
    desktop, a tabbed window -- does this open one, and then an open start page
    is raised rather than a second stacked. `--new` skips straight to that.

    `--keep` never touches the page in front: raise an open start page, or
    open one. The url bar's Enter uses it, because Enter must not change the
    window behind the overlay; its Ctrl+Enter uses plain `start`.

    Five start pages is clutter nobody asked for, and the obvious way to get
    five is pressing the bind every morning without closing yesterday's.

    Matched on the title, not the app_id alone. Chromium fixes an `--app`
    window's app_id when the window is created -- here
    `chrome-<ext id>__start.html-Default` -- and never changes it. A click on a
    tile navigates in place, so that window goes on carrying the start page's
    id while showing some other site; matching the id alone "raised" the page
    you were already on and nothing happened. The title is only `Noren Start`
    while the start page is actually showing.
    """
    ext_id = extension_id()
    if not ext_id:
        sys.exit("noren start: no extension id -- run install.sh")

    # Focused window only, not "a page somewhere on this workspace": home should
    # land on the page you are looking at or nowhere.
    active = hypr_json("activewindow") or {}
    front = (active.get("class") or "").lower()
    if not new and not keep and front.startswith("chrome-") and bridge_up():
        res = call({"cmd": "home"})
        if res.get("ok"):
            return 0

    for win in noren_windows():
        cls = (win.get("class") or "").lower()
        if (win.get("title") or "") == START_TITLE and ext_id in cls:
            return raise_window(win.get("address"))

    if bridge_up():
        def spawn():
            res = call({"cmd": "start"})
            if res.get("ok") is False:
                sys.exit(f"noren: {res.get('error', 'failed')}")
            return 0

        # In tabbed mode the start page is a page like any other: it joins the
        # group in front rather than landing beside it as a stray window.
        return spawn_and_join(spawn)

    # Browser closed: Omarchy's launcher starts it with the page as its window.
    try:
        subprocess.Popen(
            ["omarchy-launch-webapp", f"chrome-extension://{ext_id}/start.html"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except FileNotFoundError:
        sys.exit("noren: omarchy-launch-webapp not found")
    return 0


def spawn_direct(url):
    """Open a chrome-less window without the bridge.

    The host spawns windows, but the host only exists while the browser does --
    so with the browser closed the url bar could otherwise do nothing at all.
    Fall back to Omarchy's own launcher, which starts the browser if needed;
    the extension then comes up and the bridge with it.
    """
    target = normalize(url)
    if not target:
        sys.exit(f"noren: refusing to open {url!r}")
    try:
        subprocess.Popen(
            ["omarchy-launch-webapp", target],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except FileNotFoundError:
        sys.exit("noren: omarchy-launch-webapp not found")
    return {"ok": True, "spawned": True, "coldStart": True}


def call(payload, fallback=None):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(8)
            s.connect(SOCKET_PATH)
            s.sendall(json.dumps(payload).encode() + b"\n")
            buf = b""
            while b"\n" not in buf:
                chunk = s.recv(4096)
                if not chunk:
                    break
                buf += chunk
    except (ConnectionRefusedError, FileNotFoundError):
        # Either no socket at all, or a stale one left by a host that died
        # without cleaning up. Both mean the same thing to the user.
        if fallback is not None:
            return fallback()
        no_bridge()
    except socket.timeout:
        sys.exit("noren: timed out waiting for the browser")

    if not buf.strip():
        sys.exit("noren: no reply")
    return json.loads(buf.split(b"\n", 1)[0])


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0

    cmd, rest = argv[0], argv[1:]

    if cmd in ("version", "--version", "-V"):
        print(f"noren {version()}")
        return 0

    if cmd == "doctor":
        return doctor()

    if cmd == "log":
        path = os.path.join(
            os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
            "noren", "host.log",
        )
        count = 40
        if "-n" in rest:
            at = rest.index("-n")
            if at + 1 < len(rest) and rest[at + 1].isdigit():
                count = int(rest[at + 1])
        try:
            with open(path, "r", errors="replace") as fh:
                lines = fh.read().splitlines()
        except OSError:
            print(f"noren: nothing logged yet ({path})")
            return 0
        for line in lines[-count:]:
            print(line)
        return 0

    if cmd == "close":
        return close_window()

    if cmd == "ask":
        if "--last" in rest:
            return ask_last()
        ask_sweep()
        want_site = "--site" in rest
        dry_run = "--dry-run" in rest
        question = " ".join(a for a in rest
                            if a not in ("--site", "--dry-run")).strip()
        if not question:
            sys.exit("noren ask: needs a question")
        return ask(question, want_site=want_site, dry_run=dry_run)

    if cmd == "agent":
        if rest and rest[0] == "raise":
            return agent_raise()
        # What the overlay shows before anything is typed.
        print(json.dumps({"agent": default_agent(),
                          "window": bool(agent_window())}))
        return 0

    if cmd == "site":
        sub = rest[0] if rest else "list"
        arg = rest[1] if len(rest) > 1 else None
        if sub == "add":
            return site_add(arg, rest[2] if len(rest) > 2 else None)
        if sub in ("list", "ls"):
            return site_list(as_json="--json" in rest)
        if sub == "on":
            return site_toggle(arg, True)
        if sub == "off":
            return site_toggle(arg, False)
        if sub in ("rm", "remove"):
            return site_remove(arg)
        if sub == "apply":
            return site_apply(arg)
        if sub == "inspect":
            return site_inspect(arg)
        if sub == "shot":
            return site_shot(arg)
        sys.exit(f"noren site: unknown subcommand '{sub}'")

    if cmd == "search":
        config = load_config()
        if rest:
            wanted = " ".join(rest).strip()
            if not re.match(r"^https?://", wanted, re.I):
                sys.exit("noren search: needs an http(s) url, with %s where the words go")
            config["search"] = wanted
            save_config(config)
        print("search", search_template())
        return 0

    if cmd == "shatter":
        config = load_config()
        if rest and rest[0] in ("on", "curtain"):
            config["shatter"] = "curtain"
            save_config(config)
        elif rest and rest[0] == "glass":
            config["shatter"] = "glass"
            save_config(config)
        elif rest and rest[0] == "off":
            config["shatter"] = False
            save_config(config)
        elif rest and rest[0] not in ("status",):
            sys.exit(f"noren shatter: unknown argument '{rest[0]}' "
                     "(curtain | glass | off)")
        print("shatter", shatter_style() or "off")
        return 0

    if cmd == "watch":
        try:
            return watch()
        except KeyboardInterrupt:
            print("\nnoren watch: stopped")
            return 0

    if cmd == "start":
        return start_page(new="--new" in rest, keep="--keep" in rest)

    if cmd == "join":
        # Internal: the host calls this after spawning a window in tabbed mode.
        anchor, exclude = None, set()
        if "--anchor" in rest:
            at = rest.index("--anchor")
            anchor = rest[at + 1] if at + 1 < len(rest) else None
        if "--exclude" in rest:
            at = rest.index("--exclude")
            raw = rest[at + 1] if at + 1 < len(rest) else ""
            exclude = {a for a in raw.split(",") if a}
        if not anchor:
            sys.exit("noren join: needs --anchor <address>")
        return join_new(anchor, exclude)

    if cmd == "tabbed":
        config = load_config()
        if rest and rest[0] in ("on", "off"):
            config["tabbed"] = rest[0] == "on"
            save_config(config)
        elif rest and rest[0] == "toggle":
            config["tabbed"] = not config.get("tabbed")
            save_config(config)
        elif rest and rest[0] not in ("status",):
            sys.exit(f"noren tabbed: unknown argument '{rest[0]}' (on | off | toggle)")
        print("tabbed", "on" if config.get("tabbed") else "off")
        return 0

    if cmd == "bar":
        if rest and rest[0] in ("on", "off"):
            res = call({"cmd": "setRevealBar", "value": rest[0] == "on"})
            if res.get("ok") is False:
                sys.exit(f"noren: {res.get('error', 'failed')}")
            print("reveal bar", "on" if res.get("revealBar") else "off",
                  "-- reload open pages to apply")
            return 0
        res = call({"cmd": "bar"})
        if res.get("ok") is False:
            sys.exit(f"noren: {res.get('error', 'failed')}")
        return 0

    # `piece` was its name in the first commit, which is public; kept as an
    # alias for a release.
    if cmd in ("clip", "piece"):
        return clip(rest)

    if cmd == "open":
        group = "--group" in rest
        tiled = "--tiled" in rest
        flags = {"--group", "--tiled", "--tabbed"}
        urls = split_urls([a for a in rest if a not in flags])
        if not urls:
            sys.exit("noren open: needs a url")
        if len(urls) > 1 or group:
            return open_many(urls, group=group)
        # --tiled opts one window out of tabbed mode; --tabbed opts one in.
        want = True if "--tabbed" in rest else (False if tiled else None)
        return open_one(urls[0], tabbed=want)
    elif cmd == "go":
        if not rest:
            sys.exit("noren go: needs a url")
        res = call({"cmd": "navigate", "url": " ".join(rest)})
    elif cmd == "goto":
        if not rest:
            sys.exit("noren goto: needs a url")
        url = " ".join(rest)
        res = call({"cmd": "goto", "url": url},
                   fallback=lambda: spawn_direct(url))
    elif cmd == "target":
        print(json.dumps(hypr_target() or {}, indent=2))
        return 0
    elif cmd == "reload-extension":
        # Not `reload`: that is the page in front of you, and the radial's R.
        res = call({"cmd": "reloadExtension"})
        if res.get("ok"):
            print("noren: reloading the extension from disk")
        return 0
    elif cmd in ("back", "forward", "reload", "tabs", "windows", "ping", "status"):
        res = call({"cmd": cmd})
    elif cmd == "focus":
        if not rest:
            sys.exit("noren focus: needs a tab id")
        res = call({"cmd": "focus", "tabId": rest[0]})
    elif cmd == "save":
        res = call({"cmd": "saveBookmark"})
    elif cmd == "suggest":
        kind = None
        if "--kind" in rest:
            at = rest.index("--kind")
            kind = rest[at + 1] if at + 1 < len(rest) else None
            rest = rest[:at] + rest[at + 2:]
        query = " ".join(rest)
        # The start list is a page of places, not a handful of completions.
        limit = 12 if kind == "start" else 8
        if bridge_up():
            req = {"cmd": "suggest", "query": query, "limit": limit}
            if kind:
                req["kind"] = kind
            res = call(req)
        elif kind == "start":
            res = {"ok": True, "offline": True, "suggestions": offline_start(limit)}
        else:
            # No browser, no extension. Read Chromium's profile instead, so the
            # first summon of the day still completes.
            res = {"ok": True, "offline": True,
                   "suggestions": suggest_offline(query, kind, 8)}
    elif cmd == "gather":
        return gather(" ".join(rest) if rest else None)
    elif cmd == "pop":
        return pop()
    elif cmd == "set":
        sub = rest[0] if rest else "list"
        arg = rest[1] if len(rest) > 1 else None
        if sub == "save":
            return set_save(arg)
        if sub in ("list", "ls"):
            return set_list(as_json="--json" in rest)
        if sub == "preview":
            return set_preview(as_json="--json" in rest)
        if sub == "open":
            group = True if "--group" in rest else (False if "--tiled" in rest else None)
            return set_open(arg, force_group=group, replace="--replace" in rest)
        if sub in ("rm", "remove", "forget"):
            return set_remove(arg)
        if sub == "put":
            try:
                payload = json.load(sys.stdin)
            except ValueError:
                sys.exit("noren set put: expected JSON on stdin")
            return set_put(payload)
        sys.exit(f"noren set: unknown subcommand '{sub}'")
    elif cmd == "apps":
        if rest and rest[0] == "adopt":
            return apps_adopt(rest[1] if len(rest) > 1 else None)
        if rest and rest[0] == "revert":
            return apps_adopt(rest[1] if len(rest) > 1 else None, revert=True)
        if rest:
            sys.exit(f"noren apps: unknown subcommand '{rest[0]}'")
        return apps_report()
    elif cmd == "raise":
        return raise_window(rest[0] if rest else None)
    elif cmd == "scatter":
        return scatter()
    elif cmd == "theme":
        if rest:
            if rest[0] not in ("respect", "tint", "immerse"):
                sys.exit(f"noren theme: unknown mode '{rest[0]}' "
                         "(respect | tint | immerse)")
            res = call({"cmd": "theme", "mode": rest[0]})
        else:
            res = call({"cmd": "theme"})
    elif cmd == "peel":
        if rest and rest[0] in ("on", "off"):
            res = call({"cmd": "setAutoPeel", "value": rest[0] == "on"})
        elif rest and rest[0] == "status":
            res = call({"cmd": "status"})
            res = {"ok": res.get("ok", True), "autoPeel": res.get("autoPeel", False)}
        else:
            res = call({"cmd": "peel"})
    else:
        sys.exit(f"noren: unknown command '{cmd}'. Try 'noren help'.")

    if res.get("ok") is False:
        sys.exit(f"noren: {res.get('error', 'failed')}")

    # Navigation commands stay silent so Hyprland binds don't spam. Anything
    # whose purpose is to report, reports.
    if cmd in ("tabs", "windows", "suggest", "status"):
        print(json.dumps(res, indent=2))
    elif cmd == "peel" and "autoPeel" in res:
        print("auto-peel", "on" if res["autoPeel"] else "off")
    elif cmd == "theme":
        line = f"page theming {res.get('mode', '?')}"
        if res.get("palette"):
            source = "theme-supplied" if res.get("themed") else "generated"
            line += f" — {res['palette']} palette, {source}"
        if res.get("loaded") is False:
            line += " (no stylesheet yet)"
        print(line)
    elif cmd == "save":
        where = "already saved" if res.get("already") else "bookmarked"
        print(f"noren: {where} {res.get('title') or res.get('url') or ''}")
    elif cmd == "ping":
        b = res.get("browser") or {}
        if b.get("name"):
            age = res.get("sinceLoad")
            loaded = f", extension loaded {age}s ago" if age is not None else ""
            print(f"noren: bridge up — {b['name']} (pid {b['pid']}){loaded}")
        else:
            print("noren: bridge up")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
