#!/usr/bin/env python3
"""noren — drive the browser from the terminal, Hyprland binds, or the shell."""

import json
import os
import math
import re
import socket
import subprocess
import sys
import time

SOCKET_PATH = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "noren.sock"
)

USAGE = """\
usage: noren <command> [args]

  goto <url>        navigate if you're looking at a page, else open a window
  open <url>...     open each url as its own chrome-less window
  open --group ...  open them and fold them into one Hyprland group
  go <url>          navigate the focused window (force)
  back              history back
  forward           history forward
  reload            reload the focused window
  peel              move the focused tab into its own window
  peel on|off       auto-peel every new tab into its own window (persists)
  peel status       report whether auto-peel is on
  gather [match]    pull peeled windows into one Hyprland group
  pop               lift the window in front of you out of its group
  raise <address>   focus a window by Hyprland address
  set save <name>   name the pages you have open right now
  set preview       what `set save` would capture   (--json)
  set list          list your sets   (--json for the overlay)
  set open <name>   open a set, in the shape it was saved
  set rm <name>     forget a set
  apps              report webapp launchers and their window identity
  apps adopt [name] give webapp windows their app identity in alt-tab
  apps revert [name] undo that
  scatter           break the focused group back into windows
  theme             report the page-theming mode
  theme <mode>      respect | tint | immerse — theme pages from Omarchy
  tabs              list open tabs as json
  windows           list browser windows and their types as json
  save              bookmark the page in front of you
  suggest [text]    bookmark/history completions as json
                    --kind bookmark|history narrows the sources
  focus <tab-id>    focus a tab by id
  target            which browser window is on this workspace
  status            what the focused window is showing
  ping              check the bridge is up
  doctor            diagnose the whole chain end to end

The bridge runs only while your default browser is running with the Noren
extension loaded. It starts and stops with that browser.
"""


def default_browser():
    """Short name of the default browser. Omarchy exports BROWSER, which makes
    xdg-settings refuse to answer, so unset it the way omarchy's own scripts do."""
    try:
        out = subprocess.run(
            ["env", "-u", "BROWSER", "xdg-settings", "get", "default-web-browser"],
            capture_output=True, text=True, timeout=4,
        ).stdout.strip()
        return out.removesuffix(".desktop") or "your browser"
    except Exception:
        return "your browser"


def browser_running(name):
    try:
        subprocess.run(
            ["pgrep", "-x", name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True,
        )
        return True
    except Exception:
        return False


def no_bridge():
    """The host is started by the browser, so say which half is missing."""
    name = default_browser()
    if not browser_running(name):
        sys.exit(
            f"noren: {name} isn't running.\n"
            f"       The bridge starts with the browser — open {name} first."
        )
    sys.exit(
        f"noren: {name} is running but the extension hasn't connected.\n"
        f"       Restart it fully (pkill -x {name}) if you installed Noren\n"
        f"       while it was open, then check chrome://extensions."
    )



# Chromium's extensions::disable_reason bitmask. The one that matters here is
# the last: since M137 an unpacked extension is disabled unless Developer Mode
# is on, and nothing in the UI or on stderr says so.
DISABLE_REASONS = {
    1 << 0: "disabled by user",
    1 << 1: "permissions increase",
    1 << 2: "reload",
    1 << 3: "unsupported requirement",
    1 << 4: "sideload wipeout",
    1 << 7: "not verified",
    1 << 8: "greylisted",
    1 << 9: "corrupted",
    1 << 10: "remote install",
    1 << 11: "external extension",
    1 << 12: "update required by policy",
    1 << 14: "blocked by policy",
    1 << 16: "not allowlisted",
    1 << 17: "unsupported manifest version",
    1 << 24: "DEVELOPER MODE IS OFF (chrome://extensions -> Developer mode)",
}

OK, BAD, MEH = "  ok  ", " FAIL ", " warn "


def _row(status, label, detail=""):
    print(f"[{status}] {label}" + (f"  {detail}" if detail else ""))


def browser_instances(ext_dir):
    """PIDs of browser processes (not helpers) that loaded Noren's extension."""
    pids = []
    try:
        for entry in os.listdir("/proc"):
            if not entry.isdigit():
                continue
            try:
                with open(f"/proc/{entry}/cmdline", "rb") as fh:
                    args = fh.read().split(b"\0")
            except OSError:
                continue
            if not args or ext_dir.encode() not in b" ".join(args):
                continue
            # Helper processes carry --type=; the browser process does not.
            if any(a.startswith(b"--type=") for a in args):
                continue
            pids.append(entry)
    except OSError:
        return []
    return sorted(pids, key=int)


def doctor():
    here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    ext_dir = os.path.join(here, "extension")
    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    problems = 0

    name = default_browser()
    _row(OK, "default browser", name)

    running = browser_running(name)
    _row(OK if running else MEH, "browser running", "yes" if running else "no - start it")

    # One browser at a time, and one *instance* of it. Two Chromium processes
    # can both load the extension, but only one can own the native messaging
    # socket -- so every window in the other silently has no extension: nothing
    # peels there and `noren windows` cannot see them. This happened from a cold
    # multi-url open racing Chromium's singleton lock, and it is invisible
    # without looking at process arguments, which is exactly why it belongs here.
    browsers = browser_instances(ext_dir)
    if len(browsers) > 1:
        problems += 1
        _row(BAD, "browser instances",
             f"{len(browsers)} running (pids {', '.join(browsers)}) - only one owns "
             "the bridge; close them all and reopen")
    elif browsers:
        _row(OK, "browser instances", f"1 (pid {browsers[0]})")

    # Expected extension id, derived from the pinned key.
    try:
        want_id = open(os.path.join(here, "host", ".extid")).read().strip()
        _row(OK, "extension id", want_id)
    except OSError:
        want_id = None
        problems += 1
        _row(BAD, "extension id", "host/.extid missing - reinstall")

    # Service worker file actually referenced by the manifest.
    try:
        man = json.load(open(os.path.join(ext_dir, "manifest.json")))
        sw = man.get("background", {}).get("service_worker", "")
        exists = os.path.isfile(os.path.join(ext_dir, sw))
        if not exists:
            problems += 1
        _row(OK if exists else BAD, "service worker", sw + ("" if exists else " - FILE MISSING"))
    except Exception as exc:
        problems += 1
        _row(BAD, "extension manifest", str(exc))

    # Is the flag actually on the browser's command line?
    flags = os.path.join(cfg, f"{name}-flags.conf")
    in_flags = os.path.isfile(flags) and ext_dir in open(flags).read()
    if not in_flags:
        problems += 1
    _row(OK if in_flags else BAD, "--load-extension", os.path.basename(flags))

    # Native host manifest, and whether it is paired to the right id.
    nmh = os.path.join(cfg, name, "NativeMessagingHosts", "com.noren.bridge.json")
    if not os.path.isfile(nmh):
        nmh = os.path.join(cfg, "chromium", "NativeMessagingHosts", "com.noren.bridge.json")
    if os.path.isfile(nmh):
        origins = json.load(open(nmh)).get("allowed_origins", [])
        paired = any(want_id and want_id in o for o in origins)
        if not paired:
            problems += 1
        _row(OK if paired else BAD, "native host manifest",
             "paired" if paired else "id mismatch - reinstall")
    else:
        problems += 1
        _row(BAD, "native host manifest", "not found - run ./install.sh")

    # What the browser itself decided about the extension.
    prefs = os.path.join(cfg, name, "Default", "Preferences")
    if os.path.isfile(prefs):
        try:
            settings = json.load(open(prefs)).get("extensions", {}).get("settings", {})
            entry = settings.get(want_id)
            if entry is None:
                _row(MEH, "browser sees extension", "not yet - restart the browser")
            else:
                reasons = entry.get("disable_reasons") or []
                total = sum(reasons)
                if total:
                    problems += 1
                    named = [v for k, v in DISABLE_REASONS.items() if total & k] or [str(total)]
                    _row(BAD, "extension enabled", "NO - " + "; ".join(named))
                else:
                    _row(OK, "extension enabled", "yes")
        except Exception as exc:
            _row(MEH, "browser preferences", str(exc))
    else:
        _row(MEH, "browser preferences", "not found at " + prefs)

    # Page theming is independent of the bridge: it only needs Omarchy to have
    # published a palette, and the host to be able to turn it into CSS.
    try:
        sys.path.insert(0, os.path.join(here, "host"))
        import noren_theme

        if not os.path.exists(noren_theme.COLORS_FILE):
            _row(MEH, "omarchy palette", "no colors.toml - theming unavailable")
        else:
            built = noren_theme.build_css()
            if not built:
                problems += 1
                _row(BAD, "omarchy palette", "could not build a stylesheet")
            else:
                source = "theme-supplied" if built["themed"] else "generated"
                _row(OK, "page theme", f"{built['mode']} palette, {source}")
    except Exception as exc:
        problems += 1
        _row(BAD, "page theme", str(exc))

    # Completion still has to work with the browser closed, which is the first
    # summon of the day. If the profile cannot be read, the url bar is silently
    # empty until the browser happens to be open -- worth a row.
    marks = len(offline_bookmarks())
    visits = len(offline_history(limit=1))
    if marks or visits:
        _row(OK, "offline completion",
             f"{marks} bookmark(s), history "
             + ("readable" if visits else "locked (browser running)"))
    else:
        _row(MEH, "offline completion", "profile not readable - no completions "
             "while the browser is closed")

    # And finally the live bridge.
    if os.path.exists(SOCKET_PATH):
        try:
            res = call({"cmd": "ping"})
            b = (res.get("browser") or {}).get("name", "?")
            _row(OK, "bridge", f"up - {b}")
        except SystemExit:
            problems += 1
            _row(BAD, "bridge", "socket present but not answering")
    else:
        problems += 1
        _row(BAD, "bridge", "no socket - extension has not connected")

    print()
    print("All good." if not problems else f"{problems} problem(s) above.")
    return 1 if problems else 0


def hypr_target():
    """The browser window in front of you, straight from Hyprland.

    Deliberately not routed through the host: the url bar needs this to render
    its hints, and it must work with the browser closed.

    Prefers the focused window. "First browser window on this workspace" held
    only while there was at most one -- `gather` puts several on a workspace and
    list order then picks an arbitrary member. The scan is the fallback for when
    the browser is not focused at all, and it skips hidden windows because the
    inactive members of a group sit behind the active one.
    """
    # Only the default browser's windows, plus any chrome-less window (those are
    # Noren's own). Another browser's window is one the bridge cannot drive.
    owner = default_browser().lower()

    def is_browser(c):
        cls = (c.get("class") or "").lower() if c else ""
        if not cls:
            return False
        return cls.startswith("chrome-") or (owner in cls)

    def describe(c):
        cls = c.get("class") or ""
        title = c.get("title") or ""
        return {
            "title": title.rsplit(" - ", 1)[0] if " - " in title else title,
            "app_id": cls,
            "chromeless": cls.lower().startswith("chrome-"),
        }

    def ask(what):
        try:
            return json.loads(subprocess.run(
                ["hyprctl", "-j", what],
                capture_output=True, text=True, timeout=3).stdout)
        except Exception:
            return None

    active = ask("activewindow") or {}
    if is_browser(active) and active.get("class"):
        return describe(active)

    ws_id = (ask("activeworkspace") or {}).get("id")
    here = [c for c in (ask("clients") or [])
            if is_browser(c) and c.get("workspace", {}).get("id") == ws_id]
    for c in here:
        if not c.get("hidden"):
            return describe(c)
    return describe(here[0]) if here else None


# ------------------------------------------------------- offline completions
#
# With the browser closed there is no bridge, so the extension cannot answer --
# and that is precisely the summon where completion helps most, the first one of
# the day. Chromium's own profile has both: `Bookmarks` is JSON and `History` is
# SQLite. The locking works out: History is locked while Chromium runs, which is
# exactly when this path is not needed.
#
# The ranking below is a second implementation of the extension's `scoreEntry`.
# Duplicating it is a real cost, accepted because the alternative is an empty
# url bar until the browser happens to be open. Keep the two in step.

WEBKIT_EPOCH_OFFSET = 11644473600  # seconds between 1601-01-01 and 1970-01-01


def profile_dir():
    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(cfg, default_browser(), "Default")


def offline_bookmarks():
    path = os.path.join(profile_dir(), "Bookmarks")
    try:
        with open(path, "r") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return []

    found = []

    def walk(node):
        if not isinstance(node, dict):
            return
        if node.get("type") == "url" and node.get("url"):
            found.append({"url": node["url"], "title": node.get("name") or ""})
        for child in node.get("children") or []:
            walk(child)

    for root in (data.get("roots") or {}).values():
        walk(root)
    return found


def offline_history(limit=400):
    path = os.path.join(profile_dir(), "History")
    if not os.path.exists(path):
        return []
    try:
        import sqlite3

        con = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        try:
            rows = con.execute(
                "SELECT url, title, visit_count, typed_count, last_visit_time "
                "FROM urls WHERE hidden = 0 ORDER BY visit_count DESC LIMIT ?",
                (limit,),
            ).fetchall()
        finally:
            con.close()
    except Exception:
        # Locked (browser running) or unreadable. Bookmarks alone is still
        # better than nothing.
        return []

    out = []
    for url, title, visits, typed, last in rows:
        out.append({
            "url": url,
            "title": title or "",
            "visitCount": visits or 0,
            "typedCount": typed or 0,
            # Chromium stores microseconds since 1601-01-01.
            "lastVisit": ((last or 0) / 1e6) - WEBKIT_EPOCH_OFFSET,
        })
    return out


def _offline_score(entry, needle):
    url = re.sub(r"^https?://", "", entry["url"]).lower().rstrip("/")
    title = entry["title"].lower()
    score = 120 if entry["kind"] == "bookmark" else 0

    if needle:
        if url.startswith(needle):
            score += 200
        elif ("/" + needle) in url:
            score += 60
        elif needle in url:
            score += 40
        if title.startswith(needle):
            score += 80
        elif needle in title:
            score += 30

    visits = entry.get("visitCount", 0)
    score += min(60, math.log2(1 + visits) * 12)
    # A url typed by hand is a stronger signal of intent than one merely visited.
    score += min(20, entry.get("typedCount", 0) * 4)

    last = entry.get("lastVisit", 0)
    if last > 0:
        days = (time.time() - last) / 86400.0
        score += max(0, 40 - days * 2)
    return score


def suggest_offline(query, kind=None, limit=8):
    needle = (query or "").strip().lower()
    pool = {}

    def add(entry, entry_kind):
        url = entry.get("url") or ""
        if not re.match(r"^https?://", url, re.I):
            return
        key = re.sub(r"^https?://", "", url).lower().rstrip("/")
        existing = pool.get(key)
        if existing:
            if entry_kind == "bookmark":
                existing["kind"] = "bookmark"
            for field in ("visitCount", "typedCount", "lastVisit"):
                existing[field] = max(existing.get(field, 0), entry.get(field, 0))
            if not existing["title"] and entry.get("title"):
                existing["title"] = entry["title"]
            return
        merged = dict(entry)
        merged["kind"] = entry_kind
        merged.setdefault("visitCount", 0)
        merged.setdefault("typedCount", 0)
        merged.setdefault("lastVisit", 0)
        pool[key] = merged

    if kind != "history":
        for mark in offline_bookmarks():
            add(mark, "bookmark")
    if kind != "bookmark":
        for visit in offline_history():
            add(visit, "history")

    rows = list(pool.values())
    if needle:
        rows = [
            r for r in rows
            if needle in re.sub(r"^https?://", "", r["url"]).lower()
            or needle in r["title"].lower()
        ]
    rows.sort(key=lambda r: _offline_score(r, needle), reverse=True)
    return [
        {"url": r["url"], "title": r["title"], "kind": r["kind"],
         "visits": r.get("visitCount", 0)}
        for r in rows[:limit]
    ]


# ----------------------------------------------------------------------- sets
#
# Named sets of pages that open together. The point is defining them without
# typing urls: you already have the windows arranged, so `noren set save news`
# takes what is open and names it. A set also remembers whether it was a group
# when saved, and comes back that way -- the shape is part of what you saved.

SETS_FILE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "noren", "sets.json",
)


def load_sets():
    try:
        with open(SETS_FILE, "r") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_sets(sets):
    os.makedirs(os.path.dirname(SETS_FILE), exist_ok=True)
    tmp = SETS_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(sets, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, SETS_FILE)


def open_page_urls():
    """Urls of the chrome-less windows currently open, in group order.

    Comes from the extension rather than Hyprland: `hyprctl` knows titles and
    classes, not urls. Group order is preferred over window order so a set
    reopens in the order its tab strip had.
    """
    res = call({"cmd": "windows"})
    urls = {}
    for win in (res.get("windows") or []):
        if win.get("type") != "app":
            continue
        tabs = win.get("tabs") or []
        if tabs and tabs[0].get("url"):
            urls[tabs[0]["url"]] = True

    ordered = list(urls)
    # If those windows form a group, follow the group's own order.
    clients = {c.get("address"): c for c in (hypr_json("clients") or [])}
    grouped_addrs = []
    for client in clients.values():
        if (client.get("class") or "").startswith("chrome-") and client.get("grouped"):
            grouped_addrs = client["grouped"]
            break
    return ordered, bool(grouped_addrs)


def set_save(name):
    if not name:
        sys.exit("noren set save: needs a name")
    urls, grouped = open_page_urls()
    if not urls:
        sys.exit("noren set save: no chrome-less windows open to save")

    sets = load_sets()
    sets[name] = {
        "urls": urls,
        "grouped": grouped,
        "saved": time.strftime("%Y-%m-%dT%H:%M:%S"),
    }
    save_sets(sets)
    shape = "as a group" if grouped else "tiled"
    print(f"noren: saved set '{name}' — {len(urls)} page(s), {shape}")
    return 0


def set_preview(as_json=False):
    """What `set save` would capture right now.

    Exists for the overlay: the url bar offers to save the open pages under a
    typed name, and it should show what it is about to save rather than a count
    with no evidence.
    """
    try:
        urls, grouped = open_page_urls()
    except SystemExit:
        urls, grouped = [], False
    if as_json:
        print(json.dumps({"urls": urls, "grouped": grouped}))
        return 0
    if not urls:
        print("noren: no chrome-less windows open")
        return 0
    shape = "as a group" if grouped else "tiled"
    print(f"noren: {len(urls)} page(s), {shape}")
    for url in urls:
        print("  " + url)
    return 0


def set_list(as_json=False):
    sets = load_sets()
    if as_json:
        print(json.dumps(sets, indent=2, sort_keys=True))
        return 0
    if not sets:
        print("noren: no sets yet — open some pages and run `noren set save <name>`")
        return 0
    for name in sorted(sets):
        entry = sets[name] or {}
        urls = entry.get("urls") or []
        hosts = ", ".join(host_of(u) for u in urls[:4])
        if len(urls) > 4:
            hosts += f", +{len(urls) - 4} more"
        shape = "group" if entry.get("grouped") else "tiled"
        print(f"{name:<16} {len(urls):>2} page(s)  {shape:<6} {hosts}")
    return 0


def host_of(url):
    m = re.match(r"^[a-z][a-z0-9+.-]*://([^/?#]+)", str(url or ""), re.I)
    return (m.group(1) if m else str(url))[:40].replace("www.", "")


def set_open(name, force_group=None):
    sets = load_sets()
    entry = sets.get(name)
    if not entry:
        known = ", ".join(sorted(sets)) or "none"
        sys.exit(f"noren set open: no set '{name}' (have: {known})")
    urls = entry.get("urls") or []
    if not urls:
        sys.exit(f"noren set open: set '{name}' is empty")
    group = entry.get("grouped", False) if force_group is None else force_group
    return open_many(urls, group=group)


def set_remove(name):
    sets = load_sets()
    if name not in sets:
        sys.exit(f"noren set rm: no set '{name}'")
    del sets[name]
    save_sets(sets)
    print(f"noren: removed set '{name}'")
    return 0


# -------------------------------------------------------------- window identity

APPLICATIONS_DIR = os.path.expanduser("~/.local/share/applications")


def app_id_for(url, profile="Default"):
    """The app_id Chromium will give an `--app=<url>` window.

    `--class` is ignored on Wayland, so this is not a choice -- it is a
    prediction, and a wrong one matches nothing while looking correct.

    The rule is host, an underscore, then the path with slashes as underscores.
    Note that DEVELOPMENT.md's prose ("/ replaced by _") does not account for
    the separator and disagrees with its own example: a root path yields *two*
    underscores, as in `chrome-news.example.com__-Default`, which is what
    every window observed on this machine does too.
    """
    raw = str(url or "").strip().strip('"').strip("'")
    m = re.match(r"^[a-z][a-z0-9+.-]*://([^/?#]+)([^?#]*)", raw, re.I)
    if not m:
        return None
    host, path = m.group(1), m.group(2) or "/"
    if not path.startswith("/"):
        path = "/" + path
    return f"chrome-{host}_{path.replace('/', '_')}-{profile}"


def live_app_ids():
    """Classes of chrome-less windows open right now, as ground truth."""
    return {
        (c.get("class") or "")
        for c in (hypr_json("clients") or [])
        if (c.get("class") or "").startswith("chrome-")
    }


def observed_app_id(url, live):
    """A live window's class for this url's host, if one is open.

    Preferred over the prediction wherever available: the only authority on what
    Chromium calls a window is Chromium.
    """
    guess = app_id_for(url)
    if not guess:
        return None
    if guess in live:
        return guess
    host = guess[len("chrome-"):].split("_", 1)[0]
    prefix = f"chrome-{host}_"
    matches = sorted(c for c in live if c.startswith(prefix))
    return matches[0] if len(matches) == 1 else None


def desktop_webapps():
    """Launchers that open a url through omarchy-launch-webapp."""
    out = []
    try:
        names = sorted(os.listdir(APPLICATIONS_DIR))
    except OSError:
        return out
    for name in names:
        if not name.endswith(".desktop"):
            continue
        path = os.path.join(APPLICATIONS_DIR, name)
        try:
            with open(path, "r") as fh:
                text = fh.read()
        except OSError:
            continue
        if "omarchy-launch-webapp" not in text:
            continue
        url = None
        swc = None
        for line in text.splitlines():
            if line.startswith("Exec=") and "omarchy-launch-webapp" in line:
                url = line.split("omarchy-launch-webapp", 1)[1].strip()
                url = url.strip('"').strip("'").split()[0] if url else None
            elif line.startswith("StartupWMClass="):
                swc = line.split("=", 1)[1].strip()
        if url:
            out.append({"path": path, "name": name[: -len(".desktop")],
                        "url": url, "swc": swc, "text": text})
    return out


def apps_report():
    live = live_app_ids()
    apps = desktop_webapps()
    if not apps:
        print("noren: no webapp launchers found in " + APPLICATIONS_DIR)
        return 0

    print(f"{'app':<20} {'app_id':<44} state")
    for app in apps:
        seen = observed_app_id(app["url"], live)
        want = seen or app_id_for(app["url"])
        if app["swc"] == want:
            state = "set" + (" (confirmed by a live window)" if seen else " (predicted)")
        elif app["swc"]:
            state = f"MISMATCH - has {app['swc']}"
        else:
            state = "not set" + (" (confirmed)" if seen else " (predicted)")
        print(f"{app['name']:<20} {str(want):<44} {state}")
    print()
    print("A predicted app_id is unverified until that app has been opened once;")
    print("`noren apps` confirms it against the live window. `noren apps adopt`"
          " writes them.")
    return 0


def apps_adopt(only=None, revert=False):
    live = live_app_ids()
    apps = desktop_webapps()
    touched = 0

    for app in apps:
        if only and app["name"].lower() != only.lower():
            continue
        want = observed_app_id(app["url"], live) or app_id_for(app["url"])
        if not want:
            print(f"noren: cannot derive an app_id for {app['name']}", file=sys.stderr)
            continue

        lines = app["text"].splitlines()
        has = [i for i, l in enumerate(lines) if l.startswith("StartupWMClass=")]

        if revert:
            # Only remove what we would have written. A value someone else set
            # deliberately is theirs, not ours to clean up.
            removable = [i for i in has if lines[i].split("=", 1)[1].strip() == want]
            if not removable:
                continue
            for i in reversed(removable):
                lines.pop(i)
            action = "removed StartupWMClass from"
        else:
            if has and lines[has[0]].split("=", 1)[1].strip() == want:
                continue
            if has:
                lines[has[0]] = f"StartupWMClass={want}"
            else:
                # Into [Desktop Entry], after the last key of that section.
                insert_at = len(lines)
                in_entry = False
                for i, l in enumerate(lines):
                    if l.strip().startswith("["):
                        if in_entry:
                            insert_at = i
                            break
                        in_entry = l.strip() == "[Desktop Entry]"
                    elif in_entry and l.strip():
                        insert_at = i + 1
                lines.insert(insert_at, f"StartupWMClass={want}")
            action = "set StartupWMClass on"

        body = "\n".join(lines)
        if not body.endswith("\n"):
            body += "\n"
        try:
            with open(app["path"], "w") as fh:
                fh.write(body)
        except OSError as err:
            print(f"noren: could not write {app['path']}: {err}", file=sys.stderr)
            continue
        touched += 1
        print(f"noren: {action} {app['name']} ({want})")

    if touched == 0:
        print("noren: nothing to change")
    return 0


# ------------------------------------------------------------------ hyprland
#
# Every dispatcher goes through the Lua API. The legacy string form is gone on
# this Hyprland (0.56.2): `hyprctl dispatch submap reset` is a syntax error,
# only `hl.dsp.submap("reset")` works -- which also makes the legacy fallback in
# `omarchy-launch-or-focus` dead code here. Signatures below are taken from
# Omarchy's own bindings.lua rather than guessed: moving a window into a group
# is `window.move({into_group=...})`, not anything under `group`.


def hypr_json(what):
    try:
        return json.loads(subprocess.run(
            ["hyprctl", "-j", what],
            capture_output=True, text=True, timeout=3).stdout)
    except Exception:
        return None


def hypr_do(expr):
    try:
        out = subprocess.run(["hyprctl", "dispatch", expr],
                             capture_output=True, text=True, timeout=3)
        return out.stdout.strip()
    except Exception:
        return ""


def hypr_focus(address):
    hypr_do(f'hl.dsp.focus({{ window = "address:{address}" }})')


def noren_windows(pattern=None):
    """Chrome-less windows Noren made, newest last.

    Only `chrome-<host>-<profile>` app_ids: an ordinary tabbed window has class
    `chromium`, and gathering that would drag the extension's host window into a
    group with the pages. Nothing outside this prefix is ever touched.
    """
    clients = hypr_json("clients") or []
    wins = [c for c in clients
            if (c.get("class") or "").lower().startswith("chrome-")]
    if pattern:
        want = pattern.lower()
        wins = [c for c in wins
                if want in (c.get("class") or "").lower()
                or want in (c.get("title") or "").lower()]
    return wins


def gather(pattern=None, only=None):
    """Pull peeled windows back into one Hyprland group -- the return path.

    `peel` scatters and nothing brought them back, which makes a week of
    tabs-as-windows a one-way trip. The group bar then acts as the tab strip
    (SUPER+Tab is `group.active`), which is the whole premise.
    """
    wins = noren_windows(pattern)
    if only is not None:
        wanted = set(only)
        wins = [w for w in wins if w.get("address") in wanted]
    if not wins:
        print("noren: no chrome-less windows to gather"
              + (f" matching '{pattern}'" if pattern else ""))
        return 1
    if len(wins) == 1:
        print("noren: only one window; nothing to gather")
        return 0

    ws = hypr_json("activeworkspace") or {}
    active_ws = ws.get("id")
    started_on = (hypr_json("activewindow") or {}).get("address")

    # Anchor on this workspace if there is one, so gather pulls pages *to* you.
    anchor = next((c for c in wins if c.get("workspace", {}).get("id") == active_ws),
                  wins[0])
    target_ws = anchor.get("workspace", {}).get("id")
    others = [c for c in wins if c["address"] != anchor["address"]]

    # The anchor has to be a group before anything can join it.
    hypr_focus(anchor["address"])
    made_group = not anchor.get("grouped")
    if made_group:
        hypr_do("hl.dsp.group.toggle()")

    def try_fold(win):
        addr = win["address"]
        hypr_focus(addr)
        if win.get("workspace", {}).get("id") != target_ws:
            # follow=false keeps the focus from being dragged across workspaces
            # on every iteration.
            hypr_do(f'hl.dsp.window.move({{ workspace = "{target_ws}", follow = false }})')
            hypr_focus(addr)

        # into_group takes a direction, not a target, so which way the group
        # lies depends on how the layout tiled these windows. Try each and
        # check: `grouped` in `hyprctl clients` is the only honest confirmation.
        for direction in ("l", "r", "u", "d"):
            hypr_do(f'hl.dsp.window.move({{ into_group = "{direction}" }})')
            # Give the compositor a moment before believing it failed. Checking
            # immediately read a successful fold as a failure, and the loop then
            # tried the remaining three directions -- each of which can move the
            # window somewhere else. That is why a window would end up outside
            # the group *and* somewhere unexpected.
            time.sleep(0.12)
            if _is_grouped(addr):
                return True
        return False

    # Several passes, because one is not enough. With four or five windows the
    # layout can leave one of them diagonal to the group -- adjacent in no
    # cardinal direction at all -- and a single pass simply skips it. Every
    # successful fold reflows the workspace and changes what is adjacent to
    # what, so the stragglers are worth retrying. Stop as soon as a pass folds
    # nothing, rather than spinning on a window that genuinely cannot reach.
    moved = 0
    pending = list(others)
    for _ in range(4):
        if not pending:
            break
        remaining = []
        for win in pending:
            if try_fold(win):
                moved += 1
            else:
                remaining.append(win)
        if len(remaining) == len(pending):
            break
        pending = remaining
    stuck = pending

    if started_on:
        hypr_focus(started_on)

    # Not locked, deliberately. A locked group is exactly what stops a terminal
    # joining it, but Hyprland paints a locked group's bar with
    # `group:col.border_locked_active` -- default 66ff5500, orange, which Omarchy
    # never overrides. Buying the behaviour costs a red tab bar, and fixing the
    # colour means writing global Hyprland config, which this plugin does not do.
    # If you want the behaviour, set `group { auto_group = false }` in your own
    # looknfeel.lua and nothing will auto-join anything.
    print(f"noren: gathered {moved} of {len(others)} window(s) into a group")
    for win in stuck:
        print(f"       left out: {(win.get('title') or win.get('class'))[:60]}")
    return 0


def _is_grouped(address):
    for c in hypr_json("clients") or []:
        if c.get("address") == address:
            return bool(c.get("grouped"))
    return False


def front_window():
    """The chrome-less window in front of you, as a full client record.

    Both group dispatchers act on whatever Hyprland calls *active*, and both are
    normally invoked from the radial menu -- whose overlay is on screen at the
    time. So the target is resolved here and focused explicitly rather than
    assumed; guessing wrong ungroups a different group than the one you meant.

    The `hidden` check below carries less weight than it looks: measured
    2026-09-12, Hyprland reports `hidden: false` for *both* members of a
    two-window group, so it does not mark inactive group members. It still
    filters genuinely hidden windows, but the real work is done by preferring
    the active window above.
    """
    clients = hypr_json("clients") or []
    by_address = {c.get("address"): c for c in clients}

    active = hypr_json("activewindow") or {}
    target = by_address.get(active.get("address"))
    if target and (target.get("class") or "").lower().startswith("chrome-"):
        return target

    ws_id = (hypr_json("activeworkspace") or {}).get("id")
    for c in noren_windows():
        if c.get("workspace", {}).get("id") == ws_id and not c.get("hidden"):
            return c
    return None


def pop():
    """Lift the window in front of you out of its group, leaving the rest.

    `gather` is all-or-nothing and `scatter` undoes the lot; this is the middle
    case -- you grouped everything, then wanted one of them back out.
    """
    target = front_window()
    if not target:
        print("noren: no chrome-less window in front of you")
        return 1
    if len(target.get("grouped") or []) < 2:
        print("noren: that window is not in a group")
        return 1

    hypr_focus(target["address"])
    hypr_do("hl.dsp.window.move({ out_of_group = true })")
    title = (target.get("title") or target.get("class") or "")[:60]
    print(f"noren: popped out {title}")
    return 0


def raise_window(address):
    """Focus a window by Hyprland address, and say whether it took.

    Exists because the overview needs it and `Hyprland.dispatch` from Quickshell
    proved unreliable for this -- it worked once and silently did nothing twice.
    Everything else the radial menu does already shells out through this CLI, so
    this keeps one dispatch path rather than two, and this one is verified.
    """
    hex_part = re.sub(r"[^0-9a-fA-F]", "", str(address or "").replace("0x", "", 1))
    if not hex_part:
        sys.exit("noren raise: needs a window address")
    addr = "0x" + hex_part

    known = {c.get("address") for c in (hypr_json("clients") or [])}
    if addr not in known:
        sys.exit(f"noren raise: no window at {addr}")

    hypr_focus(addr)
    now = (hypr_json("activewindow") or {}).get("address")
    if now != addr:
        print(f"noren: focus did not take — still on {now}", file=sys.stderr)
        return 1
    return 0


def scatter():
    """Break the group in front of you back into ordinary tiled windows.

    This dissolves the *whole* group -- every member becomes its own tiled
    window. `pop` is the one-window version.
    """
    target = front_window()
    if not target:
        print("noren: no chrome-less window in front of you")
        return 1
    members = target.get("grouped") or []
    if len(members) < 2:
        print("noren: that window is not in a group")
        return 1

    hypr_focus(target["address"])
    hypr_do("hl.dsp.group.toggle()")
    print(f"noren: scattered {len(members)} windows into tiles")
    return 0


def normalize(url):
    """Match the host's rule: --app= needs an absolute URL or it is ignored."""
    raw = str(url or "").strip()
    if not raw:
        return None
    if re.match(r"^https?://", raw, re.I):
        return raw
    if re.match(r"^[a-z][a-z0-9+.-]*:", raw, re.I):
        return None
    return "https://" + raw


def looks_like_destination(text):
    """A token that is a place to go rather than something to search for."""
    raw = str(text or "").strip()
    if not raw or " " in raw:
        return False
    return bool(re.match(r"^[a-z][a-z0-9+.-]*://", raw, re.I)) or "." in raw


def split_urls(args):
    """Split `social.example, search.example video.example` into destinations.

    Comma is the separator. It only *counts* as one when every part is itself a
    destination -- `bread, butter recipe` is a search, and splitting it would
    open two windows for a phrase someone meant to look up. The rule lives here
    rather than in the overlay so the CLI and the url bar cannot disagree.
    """
    raw = [str(a).strip() for a in args if str(a).strip()]
    if not raw:
        return []

    # Several argv entries that are all destinations: the shell already split
    # them, as in `noren open social.example search.example`.
    if len(raw) > 1 and all(looks_like_destination(a) for a in raw):
        out = []
        for arg in raw:
            out.extend(p.strip() for p in arg.split(",") if p.strip())
        return out

    joined = " ".join(raw)
    if "," not in joined:
        return [joined]

    parts = [p.strip() for p in joined.split(",") if p.strip()]
    if len(parts) > 1 and all(looks_like_destination(p) for p in parts):
        return parts
    return [joined]


def bridge_up():
    """Whether the host socket is there *and* answering."""
    if not os.path.exists(SOCKET_PATH):
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
            probe.settimeout(1.0)
            probe.connect(SOCKET_PATH)
        return True
    except OSError:
        return False


def wait_for_bridge(timeout=25.0):
    """Block until the browser has started and its extension has connected."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if bridge_up():
            return True
        time.sleep(0.4)
    return False


def chromeless_addresses():
    return {w.get("address") for w in noren_windows()}


def open_many(urls, group=False):
    """Open each url as its own chrome-less window, optionally as one group.

    Grouping cannot be fired straight after the spawns: the windows do not exist
    yet. Wait for them to actually appear, then fold in only the ones that were
    not there before -- gathering everything would drag in whatever was already
    open, which is not what was asked for.
    """
    before = chromeless_addresses() if group else set()

    # From a cold start these must be serialised. With the browser closed every
    # url falls back to `omarchy-launch-webapp`, and two of those firing in the
    # same instant race Chromium's singleton lock: both win, and you end up with
    # two independent browser processes. Only one can own the native messaging
    # socket, so every window in the other has no working extension -- nothing
    # peels there, and `noren windows` cannot even see them. Observed exactly
    # once, with two browsers started in the same second.
    #
    # So: launch the first, wait for its extension to connect, then send the
    # rest through the bridge, which spawns them from the browser that already
    # exists.
    total = len(urls)
    cold = not bridge_up()
    if cold:
        first, urls = urls[0], urls[1:]
        try:
            spawn_direct(first)
        except SystemExit:
            print(f"noren: could not open {first!r}", file=sys.stderr)
        if not wait_for_bridge():
            print("noren: browser did not come up; opening the rest may start a "
                  "second one", file=sys.stderr)

    for url in urls:
        try:
            call({"cmd": "open", "url": url}, fallback=lambda u=url: spawn_direct(u))
        except SystemExit:
            # One bad url should not strand the rest.
            print(f"noren: could not open {url!r}", file=sys.stderr)

    if not group:
        print(f"noren: opening {total} window(s)")
        return 0

    deadline = time.monotonic() + 8.0
    fresh = set()
    while time.monotonic() < deadline:
        time.sleep(0.25)
        fresh = chromeless_addresses() - before
        if len(fresh) >= total:
            break

    if len(fresh) < 2:
        print(f"noren: opened {total} window(s); too few appeared to group")
        return 0

    # Let the last window settle before Hyprland is asked to move it.
    time.sleep(0.3)
    return gather(only=fresh)


def spawn_direct(url):
    """Open a chrome-less window without the bridge.

    The host spawns windows, but the host only exists while the browser does --
    so with the browser closed the url bar could otherwise do nothing at all.
    Fall back to Omarchy's own launcher, which starts the browser if needed;
    the extension then comes up and the bridge with it.
    """
    target = normalize(url)
    if not target:
        sys.exit(f"noren: refusing to open {url!r}")
    try:
        subprocess.Popen(
            ["omarchy-launch-webapp", target],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except FileNotFoundError:
        sys.exit("noren: omarchy-launch-webapp not found")
    return {"ok": True, "spawned": True, "coldStart": True}


def call(payload, fallback=None):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(8)
            s.connect(SOCKET_PATH)
            s.sendall(json.dumps(payload).encode() + b"\n")
            buf = b""
            while b"\n" not in buf:
                chunk = s.recv(4096)
                if not chunk:
                    break
                buf += chunk
    except (ConnectionRefusedError, FileNotFoundError):
        # Either no socket at all, or a stale one left by a host that died
        # without cleaning up. Both mean the same thing to the user.
        if fallback is not None:
            return fallback()
        no_bridge()
    except socket.timeout:
        sys.exit("noren: timed out waiting for the browser")

    if not buf.strip():
        sys.exit("noren: no reply")
    return json.loads(buf.split(b"\n", 1)[0])


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0

    cmd, rest = argv[0], argv[1:]

    if cmd == "doctor":
        return doctor()

    if cmd == "open":
        group = "--group" in rest
        urls = split_urls([a for a in rest if a != "--group"])
        if not urls:
            sys.exit("noren open: needs a url")
        if len(urls) > 1 or group:
            return open_many(urls, group=group)
        res = call({"cmd": "open", "url": urls[0]},
                   fallback=lambda: spawn_direct(urls[0]))
    elif cmd == "go":
        if not rest:
            sys.exit("noren go: needs a url")
        res = call({"cmd": "navigate", "url": " ".join(rest)})
    elif cmd == "goto":
        if not rest:
            sys.exit("noren goto: needs a url")
        url = " ".join(rest)
        res = call({"cmd": "goto", "url": url},
                   fallback=lambda: spawn_direct(url))
    elif cmd == "target":
        print(json.dumps(hypr_target() or {}, indent=2))
        return 0
    elif cmd in ("back", "forward", "reload", "tabs", "windows", "ping", "status"):
        res = call({"cmd": cmd})
    elif cmd == "focus":
        if not rest:
            sys.exit("noren focus: needs a tab id")
        res = call({"cmd": "focus", "tabId": rest[0]})
    elif cmd == "save":
        res = call({"cmd": "saveBookmark"})
    elif cmd == "suggest":
        kind = None
        if "--kind" in rest:
            at = rest.index("--kind")
            kind = rest[at + 1] if at + 1 < len(rest) else None
            rest = rest[:at] + rest[at + 2:]
        query = " ".join(rest)
        if bridge_up():
            req = {"cmd": "suggest", "query": query, "limit": 8}
            if kind:
                req["kind"] = kind
            res = call(req)
        else:
            # No browser, no extension. Read Chromium's profile instead, so the
            # first summon of the day still completes.
            res = {"ok": True, "offline": True,
                   "suggestions": suggest_offline(query, kind, 8)}
    elif cmd == "gather":
        return gather(" ".join(rest) if rest else None)
    elif cmd == "pop":
        return pop()
    elif cmd == "set":
        sub = rest[0] if rest else "list"
        arg = rest[1] if len(rest) > 1 else None
        if sub == "save":
            return set_save(arg)
        if sub in ("list", "ls"):
            return set_list(as_json="--json" in rest)
        if sub == "preview":
            return set_preview(as_json="--json" in rest)
        if sub == "open":
            group = True if "--group" in rest else (False if "--tiled" in rest else None)
            return set_open(arg, force_group=group)
        if sub in ("rm", "remove", "forget"):
            return set_remove(arg)
        sys.exit(f"noren set: unknown subcommand '{sub}'")
    elif cmd == "apps":
        if rest and rest[0] == "adopt":
            return apps_adopt(rest[1] if len(rest) > 1 else None)
        if rest and rest[0] == "revert":
            return apps_adopt(rest[1] if len(rest) > 1 else None, revert=True)
        if rest:
            sys.exit(f"noren apps: unknown subcommand '{rest[0]}'")
        return apps_report()
    elif cmd == "raise":
        return raise_window(rest[0] if rest else None)
    elif cmd == "scatter":
        return scatter()
    elif cmd == "theme":
        if rest:
            if rest[0] not in ("respect", "tint", "immerse"):
                sys.exit(f"noren theme: unknown mode '{rest[0]}' "
                         "(respect | tint | immerse)")
            res = call({"cmd": "theme", "mode": rest[0]})
        else:
            res = call({"cmd": "theme"})
    elif cmd == "peel":
        if rest and rest[0] in ("on", "off"):
            res = call({"cmd": "setAutoPeel", "value": rest[0] == "on"})
        elif rest and rest[0] == "status":
            res = call({"cmd": "status"})
            res = {"ok": res.get("ok", True), "autoPeel": res.get("autoPeel", False)}
        else:
            res = call({"cmd": "peel"})
    else:
        sys.exit(f"noren: unknown command '{cmd}'. Try 'noren help'.")

    if res.get("ok") is False:
        sys.exit(f"noren: {res.get('error', 'failed')}")

    # Navigation commands stay silent so Hyprland binds don't spam. Anything
    # whose purpose is to report, reports.
    if cmd in ("tabs", "windows", "suggest", "status"):
        print(json.dumps(res, indent=2))
    elif cmd == "peel" and "autoPeel" in res:
        print("auto-peel", "on" if res["autoPeel"] else "off")
    elif cmd == "theme":
        line = f"page theming {res.get('mode', '?')}"
        if res.get("palette"):
            source = "theme-supplied" if res.get("themed") else "generated"
            line += f" — {res['palette']} palette, {source}"
        if res.get("loaded") is False:
            line += " (no stylesheet yet)"
        print(line)
    elif cmd == "save":
        where = "already saved" if res.get("already") else "bookmarked"
        print(f"noren: {where} {res.get('title') or res.get('url') or ''}")
    elif cmd == "ping":
        b = res.get("browser") or {}
        if b.get("name"):
            print(f"noren: bridge up — {b['name']} (pid {b['pid']})")
        else:
            print("noren: bridge up")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
